#!/usr/bin/env python
# Actors need a large stack: raise the soft stack limit before anything else is loaded
from hcdworkflow.stack_limit import raise_stack_limit

raise_stack_limit()

import argparse
import os
from contextlib import ExitStack

from hcdworkflow.hcd_workflow import HCDWorkflow
from workflow.workflow_driver import get_ids_slices, setup_databases

# Management of input arguments
parser = argparse.ArgumentParser(
    description="---- Run the H&CD workflow without the interface"
)
parser.add_argument(
    "-c", "--config_folder", help="input configuration folder", required=True
)

args = vars(parser.parse_args())
config_folder = args["config_folder"]

config_folder_path = os.path.abspath(config_folder)

# Input, output and machine-description databases and waveform files, read as in hcd_nogui
inputDb, outputDb, machineDb, inputIds, inputMds, wf_parameters, param_process = setup_databases(config_folder_path)

with ExitStack() as cleanup:
    for database in (inputDb, outputDb, machineDb):
        cleanup.callback(database.close)

    # One time slice of the input and machine-description IDSs, read as in hcd_nogui
    timenow = 320.00
    ids_slices = get_ids_slices(inputDb, machineDb, inputIds, inputMds, timenow)
    nonmandatory = {k: v for k, v in ids_slices.items() if k not in ("equilibrium", "core_profiles", "workflow")}

    hcdWorkflow = HCDWorkflow()
    hcdWorkflow.initialize(config_folder_path)

    # Set status TRUE for all processes
    hcdWorkflow.setProcessStatus()

    idsData = hcdWorkflow.run(
        ids_slices["equilibrium"],
        ids_slices["core_profiles"],
        ids_slices["workflow"],
        **nonmandatory,
    )

    hcdWorkflow.finalize()
