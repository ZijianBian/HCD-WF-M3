ymmsl_version: v0.1

# =============================================================================
# Pure M3 mode — torbeam + cyrano + hcd2core_sources (stage 2)
# =============================================================================
#
# Prereq: source config_hcd_iter_sdcc.sh once in the shell before running.
#
# Topology:
#                ┌─► torbeam ────► waves_ec ─┐
#                │                            │
#   driver ─────┼─► cyrano  ────► waves_ic   │  (waves_ic computed but
#                │                            │   NOT propagated downstream
#                │                            │   in this stage — no merge_waves)
#                │                            │
#                └─► hcd2core_sources ◄──────┘
#                          │
#                          └─► core_sources ──► driver
#
#   Purpose: validate cyrano under pure M3 protocol on top of the
#   already-validated torbeam + hcd2core_sources baseline (test_m3_pure_2actors).
#
# =============================================================================

model:
  name: hcd_pure_m3_3actors

  components:
    driver:
      implementation: driver_impl
      ports:
        o_i:
          # torbeam branch
          - equilibrium_out
          - core_profiles_out
          - ec_launchers_out
          # cyrano branch
          - equilibrium_out_ic
          - core_profiles_out_ic
          - ic_antennas_out
          - waves_out_to_cyrano
          - distributions_out_ic
          - distribution_sources_out_ic
          - core_sources_out_ic
          - nbi_out_ic
          # hcd2core_sources branch (post-processing)
          - distributions_out_post
          - distribution_sources_out_post
          - waves_out_post
          - core_profiles_out_post
        s:
          - waves_in           # ← torbeam
          - waves_ic_in        # ← cyrano
          - core_sources_in    # ← hcd2core_sources

    torbeam:
      implementation: torbeam_impl
      ports:
        f_init:
          - equilibrium_in
          - core_profiles_in
          - ec_launchers_in
        o_f:
          - waves_out

    cyrano:
      implementation: cyrano_impl
      ports:
        f_init:
          - equilibrium_in
          - core_profiles_in
          - ic_antennas_in
          - waves_in
          - distributions_in
          - distribution_sources_in
          - core_sources_in
          - nbi_in
        o_f:
          - waves_out

    hcd2core_sources:
      implementation: hcd2core_sources_impl
      ports:
        f_init:
          - distributions_in
          - distribution_sources_in
          - waves_in
          - core_profiles_in
        o_f:
          - core_sources_out

  conduits:
    # driver → torbeam
    driver.equilibrium_out:    torbeam.equilibrium_in
    driver.core_profiles_out:  torbeam.core_profiles_in
    driver.ec_launchers_out:   torbeam.ec_launchers_in
    torbeam.waves_out:         driver.waves_in

    # driver → cyrano
    driver.equilibrium_out_ic:          cyrano.equilibrium_in
    driver.core_profiles_out_ic:        cyrano.core_profiles_in
    driver.ic_antennas_out:             cyrano.ic_antennas_in
    driver.waves_out_to_cyrano:         cyrano.waves_in
    driver.distributions_out_ic:        cyrano.distributions_in
    driver.distribution_sources_out_ic: cyrano.distribution_sources_in
    driver.core_sources_out_ic:         cyrano.core_sources_in
    driver.nbi_out_ic:                  cyrano.nbi_in
    cyrano.waves_out:                   driver.waves_ic_in

    # driver → hcd2core_sources
    driver.distributions_out_post:        hcd2core_sources.distributions_in
    driver.distribution_sources_out_post: hcd2core_sources.distribution_sources_in
    driver.waves_out_post:                hcd2core_sources.waves_in
    driver.core_profiles_out_post:        hcd2core_sources.core_profiles_in
    hcd2core_sources.core_sources_out:    driver.core_sources_in

settings:
  config_folder_path: "tests/m3_hybrid"
  extra_cooking: false

  torbeam.code_parameters:          "tests/m3_hybrid/ECRH/ec_wave_solver/input_torbeam.xml"
  cyrano.code_parameters:           "tests/m3_hybrid/ICRH/ic_wave_solver/input_cyrano.xml"
  hcd2core_sources.code_parameters: "tests/m3_hybrid/source/fill_core_sources/input_hcd2core_sources.xml"

resources:
  driver:           { threads: 1 }
  torbeam:          { threads: 1 }
  cyrano:           { threads: 1 }
  hcd2core_sources: { threads: 1 }

implementations:
  driver_impl:
    executable: python3
    args:
      - "hcdworkflow/workflow_driver_m3_pure.py"
      - "tests/m3_hybrid"

  torbeam_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/torbeam/torbeam_m3.exe"'

  cyrano_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/cyrano/cyrano_m3.exe"'

  hcd2core_sources_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/hcd2core_sources/hcd2core_sources_m3.exe"'
