ymmsl_version: v0.1

# HCD-Workflow with Fortran Torbeam M3
# Port structure matches standalone Torbeam (required for Fortran exe)

model:
  name: hcd_workflow_torbeam
  components:
    driver:
      implementation: hcd_driver_impl
      ports:
        o_i: [equilibrium_out, core_profiles_out, ec_launchers_out]
        s: [waves_in]
    torbeam:
      implementation: torbeam_fortran_impl
      ports:
        f_init: [equilibrium_in, core_profiles_in, ec_launchers_in]
        o_f: [waves_out]
  conduits:
    driver.equilibrium_out: torbeam.equilibrium_in
    driver.core_profiles_out: torbeam.core_profiles_in
    driver.ec_launchers_out: torbeam.ec_launchers_in
    torbeam.waves_out: driver.waves_in

settings:
    # Driver settings - will be read by workflow_driver_m3.py
    config_folder_path: "/home/ITER/bianz/public/git/repository/hcd-wf-sandbox/tests/m3_benchmark"
    extra_cooking: false
    
    # Torbeam code parameters
    torbeam.code_parameters: "/home/ITER/bianz/public/git/repository/hcd-wf-sandbox/tests/m3_benchmark/input_torbeam.xml"
    
resources:
  driver:
    threads: 1
  torbeam:
    threads: 1

implementations:
  hcd_driver_impl:
    executable: /home/ITER/bianz/public/git/repository/hcd-wf-sandbox/run_env.sh
    args:
      - "/home/ITER/bianz/public/git/repository/hcd-wf-sandbox/hcdworkflow/workflow_driver_m3.py"
    env:
      PYTHONPATH: "/home/ITER/bianz/public/git/repository/hcd-wf-sandbox"
      
  torbeam_fortran_impl:
    # Use Fortran executable directly - NO Python wrapper!
    executable: /home/ITER/bianz/public/git/repository/torbeam/tests/test_imas/build/bin/torbeam_m3.exe
