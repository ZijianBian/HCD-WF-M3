<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 
   <!-- document element -->
   <xs:element name="parameters">
     <xs:complexType>
       <xs:all>
         <xs:element ref="fopla"/>
         <xs:element name="verbosity" type="xs:integer" minOccurs="0">
           <xs:annotation>
             <xs:documentation>Determines how much information the code will print to stdout and stderr</xs:documentation>
           </xs:annotation>
         </xs:element>
	 <xs:element name="rm_tmp" type="xs:boolean">
	   <xs:annotation>
             <xs:documentation>TRUE: Delete temporary data folder</xs:documentation>
	   </xs:annotation>
	 </xs:element>
       </xs:all>
     </xs:complexType>
   </xs:element>
 
   <xs:element name="fopla">
     <xs:complexType>
       <xs:all>
         <xs:element ref="max_iterations"/>
         <xs:element ref="tolerance_Teff"/>
         <xs:element ref="N_velocity_grid"/>
         <xs:element ref="N_velocity_grid_fp"/>
         <xs:element ref="target_ions"/> 
         <xs:element ref="use_internal_power"/>
         <xs:element ref="total_power"/>
         <xs:element ref="Ntor"/>
         <xs:element ref="only_perp"/>
         <xs:element ref="include_alphas"/>
         <xs:element ref="include_nbi"/>
         <xs:element ref="select_nbi_data_source"/>
         <xs:element ref="renorm_nbi_losses"/>
         <xs:element ref="renorm_thermal_losses"/>
         <xs:element ref="imethod_ETS"/>
         <xs:element ref="EsourcekeV"/>
         <xs:element ref="deltaS"/>
         <xs:element ref="impose_tau"/>
         <xs:element ref="tau_value"/>
         <xs:element ref="force_Te_eq_Ti"/>
         <xs:element ref="lnGamma_option"/>
       </xs:all>
     </xs:complexType>
   </xs:element>
 
   <xs:element name="max_iterations" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Maximum number of iterations per magnetic surface (for consistency of collision operators)</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="tolerance_Teff" type="xs:float">
      <xs:annotation>
          <xs:documentation>Tolerance on effective temperatur, Teff, evolution to stop the iterative scheme</xs:documentation>
      </xs:annotation>
   </xs:element>
 
   <xs:element name="N_velocity_grid" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Number of points in velocity grid for Run-Stix integrator (no source)</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="N_velocity_grid_fp" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Number of points in velocity grid for Run-FP matrix inversion (with source)</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="target_ions" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Switch to choose which species without particle source (coreprof-ions) to iterate; all ion species(=0) or on a single one(=ion_index). Note that we always iterate on distributions of NBI driven populations.</xs:documentation>
      </xs:annotation>
   </xs:element>
   
   <xs:element name="use_internal_power" type="xs:boolean">
      <xs:annotation>
          <xs:documentation>Switch for computing RF power absorption internally(=1) or importing it from a waves CPO(=0)</xs:documentation>
      </xs:annotation>
   </xs:element>
 
   <xs:element name="total_power" type="xs:float">
      <xs:annotation>
          <xs:documentation>Total RF Power [W], or use power from waves-CPO when total_power.le.0)</xs:documentation>
      </xs:annotation>
   </xs:element>
 
   <xs:element name="Ntor" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Impose toroidal mode number, or use from waves-CPO for Ntor==0</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="only_perp" type="xs:boolean">
      <xs:annotation>
          <xs:documentation>UNDER DEVELOPMENT. FALSE: default 1D procedure, TRUE: force RF power in perp. direction only</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="include_alphas" type="xs:integer">
      <xs:annotation>
          <xs:documentation> 0: don't include fast alphas, &gt;0: include fast alphas from distributions</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="include_nbi" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Include NBI. 0: don't include (like StixRedist), 1: from corefast-CPO, 2: from distributions-CPO summing all sources into a single distribution, 3: from distributions-CPO separating the three energy components into three separate distributions</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="select_nbi_data_source" type="xs:integer">
      <xs:annotation>
          <xs:documentation>1: Use data from distsource, 2: Use data from ditribution</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="renorm_nbi_losses" type="xs:integer">
      <xs:annotation>
          <xs:documentation>1: Renormalize NBI power redistribution with total losses; 2: Redistribute Ploss for NBI ions based on vcrit and conc</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="renorm_thermal_losses" type="xs:integer">
      <xs:annotation>
          <xs:documentation>1: Renormalize thermal species redistribution with total losses; 2: Redistribute Ploss for thermal ions based on vcrit and conc</xs:documentation>
      </xs:annotation>
   </xs:element>


   <xs:element name="imethod_ETS" type="xs:integer">
      <xs:annotation>
          <xs:documentation>Choose amongst various methods for assembling the Pcoll source per species for the ETS input: 1 (orig), 2-9 (dirk), 10 (ernesto new_proc as stixredist)</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="EsourcekeV" type="xs:float">
      <xs:annotation>
          <xs:documentation>NBI source energy (keV). 0:read from CPO nbi, &gt;0:impose source energy (keV)</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="deltaS" type="xs:float">
      <xs:annotation>
          <xs:documentation>Relative width in energy of the NBI source (%)</xs:documentation>
      </xs:annotation>
   </xs:element>
 

   <xs:element name="impose_tau" type="xs:boolean">
      <xs:annotation>
          <xs:documentation>TRUE: Impose thermalization time (use tau_value), FALSE: use tau=energy*density/power-density, from CPO</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="tau_value" type="xs:float">
      <xs:annotation>
          <xs:documentation>Thermalisation time for NBI, tau, where the source-rate-density S=n_fast/(4*pi*tau) (same for all NBI sources)</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="force_Te_eq_Ti" type="xs:boolean">
      <xs:annotation>
          <xs:documentation>TRUE: Force Te=Ti, eliminates the equipartition substraction in Pcoll</xs:documentation>
      </xs:annotation>
   </xs:element>

   <xs:element name="lnGamma_option" type="xs:integer">
      <xs:annotation>
          <xs:documentation>0: Used fixed lnGam=17.001084, 1: Use lnGam with electron background (NRL, i-e), 2: Use lnGam with ion corrections LoGamFac (i-i). Here lnGamma is the Coulomb logarith.</xs:documentation>
      </xs:annotation>
   </xs:element>

 </xs:schema>
