<parameters>
  <input_cyrano>

    <Npol>24</Npol>                       <!--Number of poloidal modes -->
    <Np_out>0</Np_out>                    <!--Number of OUTPUT radial points (0:equilibrium, >1:value) -->
    <BC_axis>1</BC_axis>                  <!--Axis boundary conditions test (0:circular BC, 1:D-shape BC) -->
    <fix_triang>false</fix_triang>        <!--true: Fixed triangularity (edge value); false: Use triangularity fprofile from equilibrium CPO -->
    <smooth>true</smooth>                <!--true: Smooth power deposition profiles in case of tangent resonances (e.g. for large Npol); false: Don't smooth -->

    <self_consistent>
      <iterate_Teff>false</iterate_Teff>   <!--For internal self-consistent calc. with Teff from Stix_Simple -->
      <target_ions>2</target_ions>        <!--ion index for single species Teff calc. (0 = iterate on all ions) -->
      <Npstix>3000</Npstix>               <!--No. of points for v-grid for the internal Stix solver -->
      <gaussian_teff>false</gaussian_teff>    <!--true: Use Gaussian treatment of Teff; false: Use Teff directly from Stix subroutine -->
    </self_consistent>

    <fast_particles>
      <include_nbi>2</include_nbi>           <!-- 0: Don't include NBI species, 1: use corefast, 2: use distribution, 3: use distribution with 3 energy sources -->
      <include_fasticrh>0</include_fasticrh> <!-- 0: Don't include fast ICRH species, 1: use corefast, 2: use distribution (NOT READY)-->
      <include_alphas>0</include_alphas>     <!-- 0: Don't include fast alphas, 1: use corefast, 2: use distribution (NOT READY)-->
    </fast_particles>

    <overwrite_params>

      <RF>
	<total_power>0.e6</total_power>       <!--Total RF Power [W] (0:waves, 1:antennas, >1:value) -->
	<frequency>41.e6</frequency>           <!--RF frequency (0:antennas, >0:value) -->
	<Ntor>-31</Ntor>                     <!--Single toroidal mode number (0:waves, >0:value) -->
      </RF>

      <impose_antenna>false</impose_antenna>  <!--If true use values in antenna_geometry, othervise use data from antennas -->
      <antenna_geometry>
	<R_antenna>0</R_antenna>           <!--Major radius of the antenna straps at Z=0 -->
	<theta_antenna_min>-9e40</theta_antenna_min> <!--Lower end of the antenna straps given as a geometrical poloidal angle -->
	<theta_antenna_max>-9e40</theta_antenna_max> <!--Upper end of the antenna straps given as a geometrical poloidal angle -->
      </antenna_geometry>

      <nullify_Ip>false</nullify_Ip> <!--If true set the plasma current and poloidal field to zero -->

    </overwrite_params>

    <!--
    <charge_neutrality>
      <enforce_species>electrons</enforce_species>
    </charge_neutrality>
    <advanced>
      <minimum_density></minimum_density>
      <maximum_valid_density></maximum_valid_density>
    </advanced>
    -->
    
  </input_cyrano>

  <verbosity>3</verbosity>
  <rm_tmp>false</rm_tmp>                 <!--true: Delete temporary data folder -->

</parameters>