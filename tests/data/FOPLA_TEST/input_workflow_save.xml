<root>
  <workflow_parameters display="WORKFLOW PARAMETERS (STANDALONE)">
    <input_user_or_path>schneim</input_user_or_path>
    <input_database>iter</input_database>
    <shot_nr>114101</shot_nr>
    <run_in>44</run_in>
    <output_user_or_path>default</output_user_or_path>
    <output_database>default</output_database>
    <run_out>47</run_out>
    <tbegin>267.50008</tbegin>
    <tend>6</tend>
    <dt_required>2</dt_required>
    <parallel_workflow>0</parallel_workflow> 
    <one_time_slice>1</one_time_slice> 
    <!-- <run_simpletrans>False</run_simpletrans> -->
  </workflow_parameters>

  <actor_selection display="ACTOR SELECTION"> <!-- 0: none - Higher indices: following code ordering -->
    <systems>
      <ECRH>
	<ec_wave_solver list="genray gray grayscale torbeam">0</ec_wave_solver>
      </ECRH>

      <ICRH>
	<ic_coup list="iccoup">0</ic_coup> 
	<ic_wave_solver list="Cyrano tomcat pion lion">1</ic_wave_solver>
	<ic_wave_fp list="StixReDist fopla">2</ic_wave_fp>
      </ICRH>
    

      <NBI>
	<nbi_source list="nemo bbnbi">1</nbi_source>
	<nbi_fp list="risk spot ascot4serial ascot4parallel nbisim2 nerinet">1</nbi_fp>
      </NBI>
    

      <NUCLEAR>
	<nuclear_source list="afsi">0</nuclear_source> <!-- 0: none 1: AFSI -->
	<nuclear_fp list="spot ascot4serial ascot4parallel">0</nuclear_fp>
      </NUCLEAR>
    </systems> 

    <post_process>
      <source>
	<fill_core_sources list="hcd2core_sources">0</fill_core_sources> 
      </source>
      <profiles>
	<fill_core_profiles list="hcd2core_profiles">0</fill_core_profiles>
      </profiles>
    </post_process>

  </actor_selection>

</root>