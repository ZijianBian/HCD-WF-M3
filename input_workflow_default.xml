<root>
  <workflow_parameters display="WORKFLOW PARAMETERS (STANDALONE)">
    <user>public</user>
    <machine>iter</machine>
    <shot_nr>130011</shot_nr>
    <run_in>1</run_in>
    <run_out>13</run_out>
    <tbegin>5</tbegin>
    <tend>350.</tend>
    <dt_required>20</dt_required>
    <run_simpletrans>False</run_simpletrans>
  </workflow_parameters>

  <further_settings display="FURTHER SETTINGS">
    <fokker_flag>0</fokker_flag>
    <nmarker>10000</nmarker>
    <nbi_markers_in>32</nbi_markers_in>
    <ic_wave_nr_toroidal_modes>1</ic_wave_nr_toroidal_modes> 

  </further_settings>

  <actor_selection display="ACTOR SELECTION">
    <systems>
      <ECRH>
	<ec_wave_solver list="genray gray">2</ec_wave_solver>         <!-- 0: none 1: GENRAY  2: GRAY-->

      </ECRH>

      <ICRH>
	<ic_coup list="iccoup">0</ic_coup> 
	<ic_wave_solver list="Cyrano tomcat pion lion">0</ic_wave_solver>         <!-- 0: none 1: CYRANO  2: TOMCAT, 3: PION, 4: LION -->
	<ic_wave_fp list="StixReDist">0</ic_wave_fp>             <!-- 0: none 1: StixReDist 9: FP WITH NBI/IC SYNERGY -->
      </ICRH>
    

      <NBI>
	<nbi_source list="nemo bbnbi">0</nbi_source>                <!-- 0: none 1: NEMO 2: BBNBI -->
	<nbi_fp list="risk spot ascot4serial ascot4parallel">0</nbi_fp>                    <!-- 0: none 1: RISK 2: SPOT  3: ASCOT4SERIAL 4: ASCOT4PARALLEL  9: FP WITH NBI/IC SYNERGY-->
      </NBI>
    

      <NUCLEAR>
	<nuclear_source list="afsi">0</nuclear_source>             <!-- 0: none 1: AFSI -->
	<nuclear_fp list="spot ascot4serial ascot4parallel">0</nuclear_fp>                 <!-- 0: none 2: SPOT  3: ASCOT4SERIAL 4: ASCOT4PARALLEL  5: SPOT WITHOUT SOURCE-->
      </NUCLEAR>
    </systems> 

    <post_process>
      <source>
	<hcd2core_sources list="hcd2core_sources">1</hcd2core_sources> 
      </source>
      <profiles>
	<hcd2core_profiles list="hcd2core_profiles">0</hcd2core_profiles>
      </profiles>
    </post_process>

  </actor_selection>

</root>
