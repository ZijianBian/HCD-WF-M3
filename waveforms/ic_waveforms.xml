<ic_antennas>
  <configure> 
    <comment>Origin: probably converted from some CPO version, from ICRH benchmark let by R. Bilato</comment>
    <n_time_slices> 175     </n_time_slices> <!-- Number of time slices for which the ec_antennas IDS should be defined -->
    <t_begin>       1.5     </t_begin>       <!-- Starting value of the time array -->
    <t_end>         647.428 </t_end>         <!-- Final value of the time array -->
  
    <n_antennas> 2 </n_antennas>
  </configure>   
  <antenna1>
    <name>Antenna1 - Poloidally Straight 2-Strap</name>
    <identifier>Antenna1</identifier>
    <frequency_time> 0.     </frequency_time>
    <frequency>      50.5e6 </frequency>
    <power_launched_time> 0. 30. 30.01 500.  500.01 </power_launched_time> <!-- Time array for power waveform (s) -->
    <power_launched>      0. 0.  10.e6 10.e6 0.     </power_launched>      <!-- Waveform of launched power (W) -->
  </antenna1>

  <antenna2>
    <name>Antenna2 - Poloidally Straight 2-Strap</name>
    <identifier>Antenna2</identifier>
    <frequency_time> 0.     </frequency_time>
    <frequency>      50.5e6 </frequency>
    <power_launched_time> 0. </power_launched_time> <!-- Time array for power waveform (s) -->
    <power_launched>      0. </power_launched>      <!-- Waveform of launched power (W) -->
  </antenna2>


 </ic_antennas>

