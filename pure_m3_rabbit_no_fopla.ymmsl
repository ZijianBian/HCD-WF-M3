ymmsl_version: v0.1

# =============================================================================
# Pure M3 mode — Torbeam + Cyrano + Rabbit, without FoPla
# =============================================================================
#
# Rabbit runs in an isolated GCC process, but is built against the same DD 4.1.0
# and MUSCLE 0.8 wire protocol as the Intel HCD actors.  The referenced case is
# the 105102, t=100 s, EC+IC+NBI smoke configuration.
#
# =============================================================================

model:
  name: hcd_pure_m3_rabbit_no_fopla

  components:
    driver:
      implementation: driver_impl
      ports:
        o_i:
          # torbeam
          - equilibrium_out
          - core_profiles_out
          - ec_launchers_out
          # rabbit
          - core_profiles_out_rabbit
          - equilibrium_out_rabbit
          - nbi_out_rabbit
          - workflow_out_rabbit
          - wall_out_rabbit
          # cyrano
          - equilibrium_out_ic
          - core_profiles_out_ic
          - ic_antennas_out
          - waves_out_to_cyrano
          - distributions_out_ic
          - distribution_sources_out_ic
          - core_sources_out_ic
          - nbi_out_ic
          # merge_waves
          - waves_ec_out
          - waves_ic_out
          # hcd2core_sources
          - distributions_out_post
          - distribution_sources_out_post
          - waves_out_post
          - core_profiles_out_post
        s:
          - waves_in
          - waves_ic_in
          - waves_merged_in
          - core_sources_in
          - distribution_sources_rabbit_in
          - distributions_rabbit_in

    torbeam:
      implementation: torbeam_impl
      ports:
        f_init:
          - equilibrium_in
          - core_profiles_in
          - ec_launchers_in
        o_f:
          - waves_out

    rabbit:
      implementation: rabbit_impl
      ports:
        s:
          - rabbit_core_profiles_in
          - rabbit_equilibrium_in
          - rabbit_nbi_in
          - rabbit_workflow_in
        f_init:
          - rabbit_wall_in
        o_i:
          - rabbit_distribution_sources_out
          - rabbit_distributions_out

    cyrano:
      implementation: cyrano_impl
      ports:
        f_init:
          - equilibrium_in
          - core_profiles_in
          - ic_antennas_in
          - waves_in
          - distributions_in
          - distribution_sources_in
          - core_sources_in
          - nbi_in
        o_f:
          - waves_out

    merge_waves:
      implementation: merge_waves_impl
      ports:
        f_init:
          - waves1_in
          - waves2_in
        o_f:
          - waves_out

    hcd2core_sources:
      implementation: hcd2core_sources_impl
      ports:
        f_init:
          - distributions_in
          - distribution_sources_in
          - waves_in
          - core_profiles_in
        o_f:
          - core_sources_out

  conduits:
    # driver → torbeam
    driver.equilibrium_out:    torbeam.equilibrium_in
    driver.core_profiles_out:  torbeam.core_profiles_in
    driver.ec_launchers_out:   torbeam.ec_launchers_in
    torbeam.waves_out:         driver.waves_in

    # driver → rabbit (stateful NBI fast-ion actor)
    driver.core_profiles_out_rabbit: rabbit.rabbit_core_profiles_in
    driver.equilibrium_out_rabbit:   rabbit.rabbit_equilibrium_in
    driver.nbi_out_rabbit:           rabbit.rabbit_nbi_in
    driver.workflow_out_rabbit:      rabbit.rabbit_workflow_in
    driver.wall_out_rabbit:          rabbit.rabbit_wall_in
    rabbit.rabbit_distribution_sources_out: driver.distribution_sources_rabbit_in
    rabbit.rabbit_distributions_out:        driver.distributions_rabbit_in

    # driver → cyrano
    driver.equilibrium_out_ic:          cyrano.equilibrium_in
    driver.core_profiles_out_ic:        cyrano.core_profiles_in
    driver.ic_antennas_out:             cyrano.ic_antennas_in
    driver.waves_out_to_cyrano:         cyrano.waves_in
    driver.distributions_out_ic:        cyrano.distributions_in
    driver.distribution_sources_out_ic: cyrano.distribution_sources_in
    driver.core_sources_out_ic:         cyrano.core_sources_in
    driver.nbi_out_ic:                  cyrano.nbi_in
    cyrano.waves_out:                   driver.waves_ic_in

    # driver → merge_waves
    driver.waves_ec_out:       merge_waves.waves1_in
    driver.waves_ic_out:       merge_waves.waves2_in
    merge_waves.waves_out:     driver.waves_merged_in

    # driver → hcd2core_sources
    driver.distributions_out_post:        hcd2core_sources.distributions_in
    driver.distribution_sources_out_post: hcd2core_sources.distribution_sources_in
    driver.waves_out_post:                hcd2core_sources.waves_in
    driver.core_profiles_out_post:        hcd2core_sources.core_profiles_in
    hcd2core_sources.core_sources_out:    driver.core_sources_in

settings:
  config_folder_path: "tests/m3_pure_rabbit"
  extra_cooking: false

  torbeam.code_parameters:          "tests/m3_pure_rabbit/ECRH/ec_wave_solver/input_torbeam.xml"
  rabbit.code_parameters:           "tests/m3_pure_rabbit/NBI/nbi_fp/input_rabbit.xml"
  cyrano.code_parameters:           "tests/m3_pure_rabbit/ICRH/ic_wave_solver/input_cyrano.xml"
  hcd2core_sources.code_parameters: "tests/m3_pure_rabbit/source/fill_core_sources/input_hcd2core_sources.xml"

resources:
  driver:           { threads: 1 }
  torbeam:          { threads: 1 }
  rabbit:           { threads: 2 }
  cyrano:           { threads: 1 }
  merge_waves:      { threads: 1 }
  hcd2core_sources: { threads: 1 }

implementations:
  driver_impl:
    executable: python3
    args:
      - "hcdworkflow/workflow_driver_m3_pure.py"
      - "tests/m3_pure_rabbit"

  torbeam_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/torbeam/torbeam_m3.exe"'

  rabbit_impl:
    executable: bash
    args:
      - "tools/run_rabbit_m3_gcc_2023b.sh"

  cyrano_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/cyrano/cyrano_m3.exe"'

  merge_waves_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/merge_waves/merge_waves_m3.exe"'

  hcd2core_sources_impl:
    executable: bash
    args:
      - "-lc"
      - 'exec "$ACTOR_FOLDER/hcd2core_sources/hcd2core_sources_m3.exe"'
