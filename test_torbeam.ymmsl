ymmsl_version: v0.1

model:
  name: test_ecrh_loop

  components:
    driver: hcd_driver_impl
    torbeam_solver: generic_actor_impl

  conduits:
    driver.state_out: torbeam_solver.state_in
    torbeam_solver.ids_out: driver.result_from_torbeam

resources:
  driver:
    threads: 1
  torbeam_solver:
    threads: 1

implementations:
  hcd_driver_impl:
    executable: /home/ITER/bianz/public/git/repository/hcd-wf/run_env.sh
    args:
      - "/home/ITER/bianz/public/git/repository/hcd-wf/hcdworkflow/workflow_driver_m3.py"
    env:
      PYTHONPATH: "/home/ITER/bianz/public/git/repository/hcd-wf"
      HCD_ACTORS: "torbeam"

  generic_actor_impl:
    executable: /home/ITER/bianz/public/git/repository/hcd-wf/run_env.sh
    args:
      - "/home/ITER/bianz/public/git/repository/hcd-wf/hcdworkflow/workflow_actor_m3.py"
    env:
      PYTHONPATH: "/home/ITER/bianz/public/git/repository/hcd-wf"

settings:
  config_folder_path: "/home/ITER/bianz/public/git/repository/hcd-wf/tests/data/DT_baseline_example/ECRH/ec_wave_solver"
  torbeam_solver.actor_name: "torbeam"
