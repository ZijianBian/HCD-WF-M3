# RELAX (quasi-linear Fokker-Planck for EC current drive) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'RELAX'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 36011ca6c6dfd416c6f035f6e7231c8f53480a74 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/relax.git (git describe 1.0.0-4-g36011ca); source archive
# relax-2026.10.22.tar.gz = git archive --prefix=relax/ of that commit.
local_commit = '36011ca6c6dfd416c6f035f6e7231c8f53480a74'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: relax_ifx_dd3.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/relax'
description = """RELAX quasi-linear relativistic Fokker-Planck code for electron cyclotron current drive.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.0.0-4-g36011ca) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): Fortran library (lib/librelax.a with lib/libnag.a, lib/libnet.a, lib/libppp.a, include/relax), MUSCLE3 actor executable (bin/relax_m3.exe, also relax/relax_m3.exe), iWrap actor package relax (on PYTHONPATH), and the run kit run_kit (run_relax.py, run_muscle, coupling.ymmsl, input/, tests/toray_134173_106, ci-sdcc/st03-run-actor.sh).
relax_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load RELAX/2026.10.22-intel-2025b-DD-3.42.2
relax_run_setup <dir> && cd <dir>
bash ci-sdcc/st03-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on tests/toray_134173_106 (input from ITER 134173/106), checks (ST03_DIR, default ./ci-st03)
python run_relax.py -c <config folder>   # iWrap actor
./run_muscle -c <config folder>          # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTRELAX ($ACTOR_FOLDER/relax/relax_m3.exe; actor package relax on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'relax',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'relax_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '0eba5d982f7d1413eceec29b77dabf598a1e032e5231858c58fae3b01ab5e38b',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/relax'


# combination intel-2025b-dd3 of deps.yaml (same order), then Waveform-Cooker (1.9.0 as in deps.yaml of the commit)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of build.sh (the targets of ci-sdcc/st01-build-code.sh)
local_build_cmds = [
    'make -f make/makefile_imas FC="$FC" clean',
    'make -f make/makefile_imas FC="$FC" libs librelax.a',
    'make -f make/makefile_imas FC="$FC" m3',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['relax_m3.exe'], 'bin'),
    (['librelax.a', 'lib/libnag.a', 'lib/libnet.a', 'lib/libppp.a'], 'lib'),
    (['obj/*.mod'], 'include/relax'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/. && cp -p %(start_dir)s/relax_m3.exe ' + local_kit + '/relax_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/relax (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make -f make/makefile_imas FC="$FC" actor ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/relax/relax_m3.exe)
    'cp -p %(installdir)s/bin/relax_m3.exe %(installdir)s/relax/relax_m3.exe',
    'install -m 0755 %(builddir)s/relax_run_setup.sh %(installdir)s/bin/relax_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'RELAX_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/relax_m3.exe',
        'bin/relax_run_setup',
        'relax/actor.py',
        'relax/relax_m3.exe',
        'run_kit/.build_combo',
        'run_kit/relax_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/librelax.a',
        'run_kit/run_relax.py',
        'run_kit/tests/toray_134173_106/make_input.py',
        'run_kit/ci-sdcc/st03-run-actor.sh',
    ],
    'dirs': ['relax/bin', 'relax/lib', 'run_kit/ci-sdcc', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from relax.actor import relax as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "python -c 'from waveform_cooker import ec_add_dynamic'",
    "! ldd %(installdir)s/bin/relax_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/relax_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/relax/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit relax',
    'relax_run_setup --help',
]

moduleclass = 'phys'
