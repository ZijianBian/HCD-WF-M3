# FUSREAC as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 4.1.1, toolchain intel/2025b (ifx), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'FUSREAC'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 5594effe39967aa54724564d269bad1437d1a41f of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/fusreac.git (git describe 5594eff); source archive
# fusreac-2026.10.22.tar.gz = git archive --prefix=fusreac/ of that commit.
local_commit = '5594effe39967aa54724564d269bad1437d1a41f'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/fusreac'
description = """FUSREAC: fusion reaction rates and fusion-born particle sources (distribution_sources).
Version 2026.10.22 is a date label: built from commit %s (git describe 5594eff) of
origin/feature/DD3_and_DD4, for DD %s: library libfusreac_ids.a (lib), standalone program bin/fusreac_ids, MUSCLE3 actor
executable (bin/fusreac_m3.exe, also fusreac/fusreac_m3.exe), iWrap actor package fusreac (on
PYTHONPATH) and the run kit (run_fusreac.py, run_muscle, coupling.ymmsl, input,
ci-sdcc/st03-run-actor.sh);
fusreac_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'fusreac',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'fusreac_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'f9b449db7bb6c1b74231c5f41d39f5cf9fa8eaf1a2d7239f5473743f6f3ee31b',
]
start_dir = '%(builddir)s/fusreac'

# combination intel-2025b-dd4 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2025b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2025b
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),  # IMAS-Fortran/5.6.0-intel-2025b-DD-4.1.1
    ('MUSCLE3', '0.10.0'),  # MUSCLE3/0.10.0-intel-2025b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),  # XMLlib/3.3.2-intel-compilers-2025.2.0
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination, and the variables of the env files.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifx IMAS_VERSION=4.1.1 COMBO=intel-2025b-dd4 IMAS_AL_DISABLE_OBSOLESCENT_WARNING=1'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make validate, make clean, make library all DEBUG=yes, then make m3 DEBUG=yes (fusreac_m3.exe)
prebuildopts = local_env + ' && make validate && make clean DEBUG=yes FC="$FC" && make library all DEBUG=yes FC="$FC" &&'
build_cmd = 'make'
build_cmd_targets = 'm3'
buildopts = 'DEBUG=yes FC="$FC"'
maxparallel = 1

files_to_copy = [
    (['fusreac_m3.exe', 'fusreac_ids'], 'bin'),
    (['BUILD/ifx_dd4/debug/lib/libfusreac_ids.a'], 'lib'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/fusreac (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make actor DEBUG=yes FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/fusreac_m3.exe %(installdir)s/fusreac/fusreac_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by fusreac_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'fusreac fusreac\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/fusreac_run_setup.sh %(installdir)s/bin/fusreac_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '4.1.1',
    'COMBO': 'intel-2025b-dd4',
    'IMAS_AL_DISABLE_OBSOLESCENT_WARNING': '1',
    'FUSREAC_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/fusreac_m3.exe',
        'bin/fusreac_run_setup',
        'bin/fusreac_ids',
        'lib/libfusreac_ids.a',
        'fusreac/actor.py',
        'fusreac/bin/fusreac_main.exe',
        'fusreac/lib/libfusreac.so',
        'fusreac/fusreac_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/fusreac_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/fusreac_ids',
        'run_kit/BUILD/ifx_dd4/debug/lib/libfusreac_ids.a',
        'run_kit/run_fusreac.py',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/input/fusreac1d_param.xml',
    ],
    'dirs': ['fusreac/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from fusreac.actor import fusreac as a; print(a)'",
    "python -c 'import imas, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/fusreac_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/fusreac/bin/fusreac_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/fusreac_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit fusreac',
    'fusreac_run_setup --help',
]

moduleclass = 'phys'
