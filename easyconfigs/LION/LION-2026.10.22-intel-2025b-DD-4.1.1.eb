# LION (ICRF global full-wave code) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 4.1.1, toolchain intel/2025b (ifx), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'LION'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit a0273ee820eddb67d513b0ec374fe2700f2052ed of origin/feature/DD3_and_DD4,
# https://gitlab.epfl.ch/spc/LION.git (git describe 2.0.0-2-ga0273ee); source archive
# lion-2026.10.22.tar.gz = git archive --prefix=lion/ of that commit.
local_commit = 'a0273ee820eddb67d513b0ec374fe2700f2052ed'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: lion_ifx.yaml

homepage = 'https://gitlab.epfl.ch/spc/LION'
description = """LION global full-wave code for ion cyclotron (ICRF) heating in toroidal geometry.
Version 2026.10.22 is a date label: built from commit %s (git describe 2.0.0-2-ga0273ee) of
origin/feature/DD3_and_DD4 on gitlab.epfl.ch/spc/LION, for DD %s (combination %s, %s): Fortran library (lib/libLION.a, include/lion), MUSCLE3 actor executable (bin/lion_m3.exe, also lion/lion_m3.exe), iWrap actor package lion (on PYTHONPATH), and the run kit run_kit (run_lion.py, run_muscle, coupling.ymmsl, src_f90/LION_input.xml, ci-sdcc/st03-run-actor.sh). Version string V90_1_5_git_2.0.0-2-ga0273ee (GIT_DESCRIBE of src_f90/Makefile).
lion_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load LION/2026.10.22-intel-2025b-DD-4.1.1
lion_run_setup <dir> && cd <dir>
bash ci-sdcc/st03-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on ITER 130012/4 t=198.25 s, ITER_MD 110000/2, checks (ST03_DIR, default ./ci-st03)
python run_lion.py      # iWrap actor (LION_INPUT_URI, LION_MD_URI, LION_TIME, LION_OUTPUT_URI)
./run_muscle            # MUSCLE3 actor (coupling.ymmsl)
Source: commit a0273ee820eddb67d513b0ec374fe2700f2052ed of feature/DD3_and_DD4 on https://gitlab.epfl.ch/spc/LION
HCD-WF layout: ACTOR_FOLDER=$EBROOTLION ($ACTOR_FOLDER/lion/lion_m3.exe; actor package lion on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    # local archive only (checksum below): git archive of the commit of https://gitlab.epfl.ch/spc/LION
    {'filename': '%(namelower)s-%(version)s.tar.gz'},
    {
        'filename': 'lion_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    'b9f2b470a00ed337d7900cbd42694a863e302f9abda822315feba210aced0632',
    '6c0fb7271ac8f4c3c526097436a881bb7188786e02886bf28fb1d799380a06c4',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/lion'


# combination intel-2025b-dd4 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
    ('INTERPOS', '9.2.3', '', ('iimkl', '2025b')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh (DEBUG=no; GIT_DESCRIBE given, the archive has no .git)
local_build_cmds = [
    'make -C src_f90/ clean veryclean validate libraries IMAS_ENVIRONMENT_LOADED=yes DEBUG=no F90="$FC" GIT_DESCRIBE=2.0.0-2-ga0273ee',
    'make -C src_f90/ m3 IMAS_ENVIRONMENT_LOADED=yes DEBUG=no F90="$FC" GIT_DESCRIBE=2.0.0-2-ga0273ee',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['src_f90/lion_m3.exe'], 'bin'),
    (['src_f90/libLION.a'], 'lib'),
    (['src_f90/lion_iwrap.mod'], 'include/lion'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/src_f90 && cp -p %(start_dir)s/src_f90/lion_m3.exe ' + local_kit + '/src_f90/lion_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/lion (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make -C src_f90/ iwrap_actor IMAS_ENVIRONMENT_LOADED=yes DEBUG=no F90="$FC" GIT_DESCRIBE=2.0.0-2-ga0273ee ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/lion/lion_m3.exe)
    'cp -p %(installdir)s/bin/lion_m3.exe %(installdir)s/lion/lion_m3.exe',
    'install -m 0755 %(builddir)s/lion_run_setup.sh %(installdir)s/bin/lion_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'LION_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/lion_m3.exe',
        'bin/lion_run_setup',
        'lion/actor.py',
        'lion/lion_m3.exe',
        'run_kit/.build_combo',
        'run_kit/src_f90/lion_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libLION.a',
        'run_kit/run_lion.py',
        'run_kit/src_f90/LION_input.xml',
        'run_kit/ci-sdcc/st03-run-actor.sh',
    ],
    'dirs': ['lion/bin', 'lion/lib', 'run_kit/ci-sdcc'],
}

sanity_check_commands = [
    "python -c 'from lion.actor import lion as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/lion_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/lion_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/lion/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit lion',
    'lion_run_setup --help',
]

moduleclass = 'phys'
