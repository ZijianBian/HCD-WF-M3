# NEMO as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2023b (ifort), combination intel-2023b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'NEMO'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit c8fbe1605e3a60758f8f393d3d0931f45018ac2a of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/nemo.git (git describe 2.2.0-12-gc8fbe16); source archive
# nemo-2026.10.22.tar.gz = git archive --prefix=nemo/ of that commit.
local_commit = 'c8fbe1605e3a60758f8f393d3d0931f45018ac2a'
local_combo = 'intel-2023b-dd3'
local_fc = 'ifort'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/nemo'
description = """NEMO: NBI ionisation and fast-ion source code (with the in-tree grid_library).
Version 2026.10.22 is a date label: built from commit %s (git describe 2.2.0-12-gc8fbe16) of
origin/feature/DD3_and_DD4, for DD %s: library libnemo.a (lib, with the FRUIT test hooks of USE_FRUIT=yes), MUSCLE3 actor
executable (bin/nemo_m3.exe, also nemo/nemo_m3.exe), iWrap actor package nemo (on PYTHONPATH)
and the run kit (run_nemocode, run_nemo, run_muscle, coupling.ymmsl, input,
ci-sdcc/st03-run-actor.sh, ci-sdcc/st05-run-actor.sh);
nemo_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2023b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'nemo',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'nemo_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '6658cbd705f422ef2e353a3698cec9650de643d4f540b654cc8f206e52800de0',
]
start_dir = '%(builddir)s/nemo'

# combination intel-2023b-dd3 of deps.yaml (same order), then the Waveform-Cooker component
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2023b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2023b
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),  # IMAS-Fortran/5.6.0-intel-2023b-DD-3.42.2
    ('IDStools', '2.5.0'),  # IDStools/2.5.0-intel-2023b
    ('MUSCLE3', '0.8.0'),  # MUSCLE3/0.8.0-intel-2023b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2023.2.1')),  # XMLlib/3.3.2-intel-compilers-2023.2.1
    ('INTERPOS', '9.2.0', '', ('iimkl', '2023b')),  # INTERPOS/9.2.0-iimkl-2023b
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '13.2.0')),  # Waveform-Cooker/1.9.0-GCCcore-13.2.0
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifort IMAS_VERSION=3.42.2 COMBO=intel-2023b-dd3'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make DEBUG=yes USE_FRUIT=yes clean validate library m3 (libnemo.a, nemo_m3.exe)
prebuildopts = local_env + ' &&'
build_cmd = 'make'
build_cmd_targets = 'clean validate library m3'
buildopts = 'DEBUG=yes USE_FRUIT=yes FCOMPILER="$FC"'
maxparallel = 1

files_to_copy = [
    (['nemo_m3.exe'], 'bin'),
    (['libnemo.a'], 'lib'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/nemo (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make actor DEBUG=yes USE_FRUIT=yes FCOMPILER="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/nemo_m3.exe %(installdir)s/nemo/nemo_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by nemo_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'nemo nemo\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/nemo_run_setup.sh %(installdir)s/bin/nemo_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '3.42.2',
    'COMBO': 'intel-2023b-dd3',
    'NEMO_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/nemo_m3.exe',
        'bin/nemo_run_setup',
        'lib/libnemo.a',
        'nemo/actor.py',
        'nemo/bin/nemo_main.exe',
        'nemo/lib/libnemo.so',
        'nemo/nemo_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/nemo_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/obj_ifort/libnemo.a',
        'run_kit/run_nemocode',
        'run_kit/run_nemo',
        'run_kit/dd_compat.py',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/input/input_nemo_reg.xml',
        'run_kit/input/scenario.yaml',
    ],
    'dirs': ['nemo/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from nemo.actor import nemo as a; print(a)'",
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/nemo_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/nemo/bin/nemo_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/nemo_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit nemo',
    'nemo_run_setup --help',
]

moduleclass = 'phys'
