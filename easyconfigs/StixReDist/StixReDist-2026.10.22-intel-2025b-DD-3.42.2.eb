# StixReDist as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'StixReDist'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 750c24c8d05d34f5946f9b8d0f4e97a4a98edfd8 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/stixredist.git (git describe 2.1.0-7-g750c24c); source archive
# stixredist-2026.10.22.tar.gz = git archive --prefix=stixredist/ of that commit.
local_commit = '750c24c8d05d34f5946f9b8d0f4e97a4a98edfd8'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/stixredist'
description = """StixReDist: ICRF quasi-linear redistribution of fast ions (Stix model).
Version 2026.10.22 is a date label: built from commit %s (git describe 2.1.0-7-g750c24c) of
origin/feature/DD3_and_DD4, for DD %s: library libstix_redist_ids.a (lib), MUSCLE3 actor executable (bin/stixredist_m3.exe,
also stix_redist/stixredist_m3.exe), iWrap actor package stix_redist (on PYTHONPATH) and the
run kit (run_stix_redist, run_muscle, coupling.ymmsl, input, ci-sdcc/st03-run-actor.sh with
its test entry ci-sdcc/st03-imasdb);
stixredist_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'stixredist',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'stixredist_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '82c9021600ac28a88a3a29139151bc2eb54a56a5580b550e6f7d547f2f864db4',
]
start_dir = '%(builddir)s/stixredist'

# combination intel-2025b-dd3 of deps.yaml (same order), then the Waveform-Cooker component
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2025b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2025b
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),  # IMAS-Fortran/5.6.0-intel-2025b-DD-3.42.2
    ('MUSCLE3', '0.10.0'),  # MUSCLE3/0.10.0-intel-2025b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),  # XMLlib/3.3.2-intel-compilers-2025.2.0
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),  # Waveform-Cooker/1.9.0-GCCcore-14.3.0
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifx IMAS_VERSION=3.42.2 COMBO=intel-2025b-dd3'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make veryclean validate library DEBUG=yes, then make m3 DEBUG=yes (stixredist_m3.exe)
prebuildopts = local_env + ' && make veryclean validate library DEBUG=yes FC="$FC" &&'
build_cmd = 'make'
build_cmd_targets = 'm3'
buildopts = 'DEBUG=yes FC="$FC"'
maxparallel = 1

files_to_copy = [
    (['stixredist_m3.exe'], 'bin'),
    (['BUILD/debug/lib/libstix_redist_ids.a'], 'lib'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/stix_redist (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make iwrap_actor DEBUG=yes FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/stixredist_m3.exe %(installdir)s/stix_redist/stixredist_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by stixredist_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'stix_redist stix_redist\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/stixredist_run_setup.sh %(installdir)s/bin/stixredist_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '3.42.2',
    'COMBO': 'intel-2025b-dd3',
    'STIXREDIST_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/stixredist_m3.exe',
        'bin/stixredist_run_setup',
        'lib/libstix_redist_ids.a',
        'stix_redist/actor.py',
        'stix_redist/bin/stix_redist_main.exe',
        'stix_redist/lib/libstix_redist.so',
        'stix_redist/stixredist_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/stixredist_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/BUILD/debug/lib/libstix_redist_ids.a',
        'run_kit/run_stix_redist',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/ci-sdcc/st03-scenario.yaml',
        'run_kit/ci-sdcc/st03-imasdb/ITER/4/130012/100/master.h5',
        'run_kit/input/stix_redist.xml',
    ],
    'dirs': ['stix_redist/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from stix_redist.actor import stix_redist as a; print(a)'",
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/stixredist_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/stix_redist/bin/stix_redist_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/stixredist_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit stixredist',
    'stixredist_run_setup --help',
]

moduleclass = 'phys'
