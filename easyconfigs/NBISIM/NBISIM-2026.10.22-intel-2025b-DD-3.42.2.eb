# NBISIM as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'NBISIM'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 1980312b6d26210bdd113d15ccdcaa26dd23a976 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/nbisim.git (git describe 1.3.0-2-g1980312); source archive
# nbisim-2026.10.22.tar.gz = git archive --prefix=nbisim/ of that commit.
local_commit = '1980312b6d26210bdd113d15ccdcaa26dd23a976'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/nbisim'
description = """NBISIM: neutral beam injection fast-ion slowing-down code.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.3.0-2-g1980312) of
origin/feature/DD3_and_DD4, for DD %s: library libnbisim2.a (lib, include/nbisim), MUSCLE3 actor executable (bin/nbisim_m3.exe,
also nbisim/nbisim_m3.exe), iWrap actor package nbisim (on PYTHONPATH) and the run kit
(run_nbisim.py, run_muscle, coupling.ymmsl, input, ci-sdcc/st03-run-actor.sh);
nbisim_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'nbisim',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'nbisim_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'bf3a2398919712de100d0aed7280fb21b15ba3979672a376c30a5999c4bd7dba',
]
start_dir = '%(builddir)s/nbisim'

# combination intel-2025b-dd3 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2025b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2025b
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),  # IMAS-Fortran/5.6.0-intel-2025b-DD-3.42.2
    ('MUSCLE3', '0.10.0'),  # MUSCLE3/0.10.0-intel-2025b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),  # XMLlib/3.3.2-intel-compilers-2025.2.0
    ('INTERPOS', '9.2.3', '', ('iimkl', '2025b')),  # INTERPOS/9.2.3-iimkl-2025b
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifx IMAS_VERSION=3.42.2 COMBO=intel-2025b-dd3'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make -C devel/ veryclean veryclean-deps, make -C devel/ (libnbisim2.a), then make -C devel/ m3 (nbisim_m3.exe)
prebuildopts = local_env + ' && make -C devel/ veryclean veryclean-deps DATAMODEL=IMAS DEBUG=yes FC="$FC" && make -C devel/ DATAMODEL=IMAS DEBUG=yes FC="$FC" SVNVERSION=unknown SVNURL=unknown SVNROOT=unknown &&'
build_cmd = 'make'
build_cmd_targets = '-C devel/ m3'
buildopts = 'DATAMODEL=IMAS DEBUG=yes FC="$FC" SVNVERSION=unknown SVNURL=unknown SVNROOT=unknown'
maxparallel = 1

files_to_copy = [
    (['nbisim_m3.exe'], 'bin'),
    (['devel/BUILD/IMAS/ifx/debug/lib/libnbisim2.a'], 'lib'),
    (['devel/BUILD/IMAS/ifx/debug/mod/imas_nbisim.mod'], 'include/nbisim'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/nbisim (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make -C devel/ iwrap_actor DATAMODEL=IMAS DEBUG=yes FC="$FC" SVNVERSION=unknown SVNURL=unknown SVNROOT=unknown ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/nbisim_m3.exe %(installdir)s/nbisim/nbisim_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by nbisim_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'devel/nbisim nbisim\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/nbisim_run_setup.sh %(installdir)s/bin/nbisim_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '3.42.2',
    'COMBO': 'intel-2025b-dd3',
    'NBISIM_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/nbisim_m3.exe',
        'bin/nbisim_run_setup',
        'lib/libnbisim2.a',
        'include/nbisim/imas_nbisim.mod',
        'nbisim/actor.py',
        'nbisim/bin/nbisim_main.exe',
        'nbisim/lib/libnbisim.so',
        'nbisim/nbisim_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/nbisim_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/devel/BUILD/IMAS/ifx/debug/lib/libnbisim2.a',
        'run_kit/run_nbisim.py',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/ci-sdcc/st03-scenario.yaml',
        'run_kit/input/input_nbisim2.xml',
    ],
    'dirs': ['nbisim/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from nbisim.actor import nbisim as a; print(a)'",
    "python -c 'import imas, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/nbisim_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/nbisim/bin/nbisim_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/nbisim_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit nbisim',
    'nbisim_run_setup --help',
]

moduleclass = 'phys'
