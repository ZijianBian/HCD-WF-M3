# GRAY (EC beam tracing) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 4.1.1, toolchain intel/2025b (ifx), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'GRAY'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 9792659ddb9d67561d0b6d9a16acaf5d022022af of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/gray.git (git describe 1.0.0-7-g9792659); source archive
# gray-2026.10.22.tar.gz = git archive --prefix=gray/ of that commit.
local_commit = '9792659ddb9d67561d0b6d9a16acaf5d022022af'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: gray_ifx.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/gray'
description = """GRAY quasi-optical beam-tracing code for electron cyclotron heating and current drive.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.0.0-7-g9792659) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): Fortran library (lib/libgray.a, include/gray), MUSCLE3 actor executable (bin/gray_m3.exe, also gray/gray_m3.exe), iWrap actor package gray (on PYTHONPATH), and the run kit run_kit (run_gray.py, run_muscle, coupling.ymmsl, inputs/). Built with DEBUG=1 as ci-sdcc/st01 + st02 and build.sh.
gray_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load GRAY/2026.10.22-intel-2025b-DD-4.1.1
gray_run_setup <dir> && cd <dir>
python run_gray.py      # iWrap actor (inputs/scenario[_dd3].yaml: output_user_or_path, run_out)
./run_muscle            # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTGRAY ($ACTOR_FOLDER/gray/gray_m3.exe; actor package gray on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'gray',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'gray_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '6c9ca19a34e7a0bac2c92969da7d3602557d0e172599c57052de62b452a7f668',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/gray'


# combination intel-2025b-dd4 of deps.yaml (same order), then Waveform-Cooker (official 1.10.0 for DD4 where deps.yaml names the user build 14.4.0.dev1: mirror steering ec_mirror_add_dynamic; 1.9.0 as in deps.yaml for DD3)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
    ('Waveform-Cooker', '1.10.0', '', ('GCCcore', '14.3.0')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh (DEBUG=1, as st02 and build.sh)
local_build_cmds = [
    'make clean xmlval libgray.a DEBUG=1 FC="$FC"',
    'make m3 DEBUG=1 FC="$FC"',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['gray_m3.exe'], 'bin'),
    (['libgray.a'], 'lib'),
    (['*.mod'], 'include/gray'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/. && cp -p %(start_dir)s/gray_m3.exe ' + local_kit + '/gray_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/gray (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make iwrapactor DEBUG=1 FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/gray/gray_m3.exe)
    'cp -p %(installdir)s/bin/gray_m3.exe %(installdir)s/gray/gray_m3.exe',
    'install -m 0755 %(builddir)s/gray_run_setup.sh %(installdir)s/bin/gray_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'GRAY_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/gray_m3.exe',
        'bin/gray_run_setup',
        'gray/actor.py',
        'gray/gray_m3.exe',
        'run_kit/.build_combo',
        'run_kit/gray_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libgray.a',
        'run_kit/run_gray.py',
        'run_kit/inputs/scenario.yaml',
        'run_kit/inputs/scenario_dd3.yaml',
    ],
    'dirs': ['gray/bin', 'gray/lib', 'run_kit/ci-sdcc', 'run_kit/inputs'],
}

sanity_check_commands = [
    "python -c 'from gray.actor import gray as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "python -c 'from waveform_cooker import add_dynamic, ec_mirror_add_dynamic'",
    "! ldd %(installdir)s/bin/gray_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/gray_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/gray/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit gray',
    'gray_run_setup --help',
]

moduleclass = 'phys'
