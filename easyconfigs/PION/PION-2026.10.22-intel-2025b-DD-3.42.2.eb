# PION as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'PION'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 69bf1b6e98a1f3e0505e53ed040f2c56ebbf7cc6 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/pion.git (git describe 2.1.0-5-g69bf1b6); source archive
# pion-2026.10.22.tar.gz = git archive --prefix=pion/ of that commit.
local_commit = '69bf1b6e98a1f3e0505e53ed040f2c56ebbf7cc6'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/pion'
description = """PION ICRF heating code (ICRH power deposition and fast-ion distribution).
Version 2026.10.22 is a date label: built from commit %s (git describe 2.1.0-5-g69bf1b6) of
origin/feature/DD3_and_DD4, for DD %s: library pimascal.a (lib, include/pion), MUSCLE3 actor executable (bin/pion_m3.exe, also
pion/pion_m3.exe), iWrap actor package pion (on PYTHONPATH) and the run kit (run_pion.py,
run_muscle, coupling.ymmsl, input, ci-sdcc/st03-run-actor.sh);
pion_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}
# No RPATH wrappers: with them, make m3 fails to link against the MKL bundled with NAG/26 (libmkl_def.so: undefined mkl_sparse_* symbols).
toolchainopts = {'rpath': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'pion',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'pion_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'c87e75d4cf098ce671701174ca5564fd68bedd15d782644dd144bd28b4f8d560',
]
start_dir = '%(builddir)s/pion'

# combination intel-2025b-dd3 of deps.yaml (same order), then the Waveform-Cooker component
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2025b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2025b
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),  # IMAS-Fortran/5.6.0-intel-2025b-DD-3.42.2
    ('MUSCLE3', '0.10.0'),  # MUSCLE3/0.10.0-intel-2025b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),  # XMLlib/3.3.2-intel-compilers-2025.2.0
    ('INTERPOS', '9.2.3', '', ('iimkl', '2025b')),  # INTERPOS/9.2.3-iimkl-2025b
    ('NAG', '26', '', ('intel-compilers', '2025.2.0')),  # NAG/26-intel-compilers-2025.2.0
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),  # Waveform-Cooker/1.9.0-GCCcore-14.3.0
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination, and the variables of the env files.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifx IMAS_VERSION=3.42.2 COMBO=intel-2025b-dd3 IMASFORPION=DIMAS_LATEST'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make clean veryclean, make pimascal.a, then make m3 (pion_m3.exe)
prebuildopts = local_env + ' && make clean veryclean FC="$FC" && make pimascal.a FC="$FC" &&'
build_cmd = 'make'
build_cmd_targets = 'm3'
buildopts = 'FC="$FC"'
maxparallel = 1

files_to_copy = [
    (['pion_m3.exe'], 'bin'),
    (['pimascal.a'], 'lib'),
    (['fortran_imas/*.mod'], 'include/pion'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/pion (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make iwrap_actor FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/pion_m3.exe %(installdir)s/pion/pion_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by pion_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'pion pion\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/pion_run_setup.sh %(installdir)s/bin/pion_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '3.42.2',
    'COMBO': 'intel-2025b-dd3',
    'IMASFORPION': 'DIMAS_LATEST',
    'PION_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/pion_m3.exe',
        'bin/pion_run_setup',
        'lib/pimascal.a',
        'include/pion/pion_iwrap.mod',
        'pion/actor.py',
        'pion/bin/pion_main.exe',
        'pion/lib/libpion.so',
        'pion/pion_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/pion_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/pimascal.a',
        'run_kit/fortran_imas/pion_iwrap.mod',
        'run_kit/run_pion.py',
        'run_kit/dd_compat.py',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/input/input_pion.xml',
    ],
    'dirs': ['pion/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from pion.actor import pion as a; print(a)'",
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/pion_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/pion/bin/pion_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/pion_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit pion',
    'pion_run_setup --help',
]

moduleclass = 'phys'
