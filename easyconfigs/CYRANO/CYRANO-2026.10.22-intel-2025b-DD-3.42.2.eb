# CYRANO (ICRF full-wave solver) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'CYRANO'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit a1ac2d3abf78c0e8192b146c331bef87fe69c7fe of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/cyrano.git (git describe 1.0.0-7-ga1ac2d3); source archive
# cyrano-2026.10.22.tar.gz = git archive --prefix=cyrano/ of that commit.
local_commit = 'a1ac2d3abf78c0e8192b146c331bef87fe69c7fe'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: iwrap/cyrano_ifx_dd3.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/cyrano'
description = """CYRANO full-wave solver for ICRF wave fields (P. U. Lamalle, PhD thesis, Universite de Mons, 1994).
Version 2026.10.22 is a date label: built from commit %s (git describe 1.0.0-7-ga1ac2d3) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): Fortran library (lib/libcyrano_ids.a, include/cyrano), MUSCLE3 actor executable (bin/cyrano_m3.exe, also cyrano/cyrano_m3.exe, the HCD-WF pure topology path), iWrap actor package cyrano (on PYTHONPATH), and the run kit run_kit (run_cyrano.py, run_muscle, coupling.ymmsl, input/, ci-sdcc/st05-run-actor.sh). Built with DEBUG=yes as ci-sdcc/st01 + st02 (the committed iWrap yamls use the debug library).
cyrano_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load CYRANO/2026.10.22-intel-2025b-DD-3.42.2
cyrano_run_setup <dir> && cd <dir>
bash ci-sdcc/st05-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on ITER 130012/4 t=200 s, ITER_MD 110000/2, checks (ST05_DIR, default ./ci-st05)
python run_cyrano.py    # iWrap actor (CYRANO_INPUT_URI, CYRANO_MD_URI, CYRANO_TIME, CYRANO_OUTPUT_URI)
./run_muscle            # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTCYRANO ($ACTOR_FOLDER/cyrano/cyrano_m3.exe; actor package cyrano on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'cyrano',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'cyrano_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '29f380078c85f9983384b077c0cae755e7c056720567466c28f4a596d66ee81b',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/cyrano'


# combination intel-2025b-dd3 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),
    ('IDStools', '2.5.0'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh (DEBUG=yes)
local_build_cmds = [
    'make veryclean validate library DEBUG=yes FC="$FC"',
    'make all DEBUG=yes FC="$FC"',
    'make m3 DEBUG=yes FC="$FC"',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['cyrano_m3.exe'], 'bin'),
    (['BUILD/debug/lib/libcyrano_ids.a'], 'lib'),
    (['BUILD/debug/obj/*.mod'], 'include/cyrano'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/. && cp -p %(start_dir)s/cyrano_m3.exe ' + local_kit + '/cyrano_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/cyrano (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make actor DEBUG=yes FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/cyrano/cyrano_m3.exe)
    'cp -p %(installdir)s/bin/cyrano_m3.exe %(installdir)s/cyrano/cyrano_m3.exe',
    'install -m 0755 %(builddir)s/cyrano_run_setup.sh %(installdir)s/bin/cyrano_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'CYRANO_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/cyrano_m3.exe',
        'bin/cyrano_run_setup',
        'cyrano/actor.py',
        'cyrano/cyrano_m3.exe',
        'run_kit/.build_combo',
        'run_kit/cyrano_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libcyrano_ids.a',
        'run_kit/run_cyrano.py',
        'run_kit/input/input_cyrano.xml',
        'run_kit/ci-sdcc/st05-run-actor.sh',
    ],
    'dirs': ['cyrano/bin', 'cyrano/lib', 'run_kit/ci-sdcc', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from cyrano.actor import cyrano as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/cyrano_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/cyrano_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/cyrano/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit cyrano',
    'cyrano_run_setup --help',
]

moduleclass = 'phys'
