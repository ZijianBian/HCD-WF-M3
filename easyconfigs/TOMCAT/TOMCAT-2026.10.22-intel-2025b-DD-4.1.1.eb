# TOMCAT (ICRF 1D full-wave solver) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 4.1.1, toolchain intel/2025b (ifx), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'TOMCAT'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 50129f7d88e0436874beaa252f4edc4646d943b4 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/tomcat.git (git describe 1.0.0-2-g50129f7); source archive
# tomcat-2026.10.22.tar.gz = git archive --prefix=tomcat/ of that commit.
local_commit = '50129f7d88e0436874beaa252f4edc4646d943b4'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: tomcat_ifx.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/tomcat'
description = """TOMCAT one-dimensional full-wave code for ion cyclotron (ICRF) heating.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.0.0-2-g50129f7) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): Fortran library (lib/libtomcat.a, include/tomcat), MUSCLE3 actor executable (bin/tomcat_m3.exe, also tomcat/tomcat_m3.exe), iWrap actor package tomcat (on PYTHONPATH), and the run kit run_kit (run_tomcat.py, run_muscle, coupling.ymmsl, input/, ci-sdcc/st03-run-actor.sh).
tomcat_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load TOMCAT/2026.10.22-intel-2025b-DD-4.1.1
tomcat_run_setup <dir> && cd <dir>
bash ci-sdcc/st03-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on ITER 130012/5 t=200 s, checks (ST03_DIR, default ./ci-st03)
python run_tomcat.py --src <uri> --dest <uri> --time <t> -cp input/tomcat.xml   # iWrap actor
./run_muscle [settings.ymmsl]   # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTTOMCAT ($ACTOR_FOLDER/tomcat/tomcat_m3.exe; actor package tomcat on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'tomcat',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'tomcat_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'c4530f191d9546c3153d5a9c301a6231d88ec4a9be1013a7b27ba06b632152d2',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/tomcat'


# combination intel-2025b-dd4 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh (DEBUG=no)
local_build_cmds = [
    'make -C fortran_sources/ clean library DEBUG=no FC="$FC"',
    'make -C fortran_sources/ m3 DEBUG=no FC="$FC"',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['tomcat_m3.exe'], 'bin'),
    (['fortran_sources/obj/libtomcat.a'], 'lib'),
    (['fortran_sources/obj/*.mod'], 'include/tomcat'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/. && cp -p %(start_dir)s/tomcat_m3.exe ' + local_kit + '/tomcat_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/tomcat (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make -C fortran_sources/ iwrap_actor DEBUG=no FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/tomcat/tomcat_m3.exe)
    'cp -p %(installdir)s/bin/tomcat_m3.exe %(installdir)s/tomcat/tomcat_m3.exe',
    'install -m 0755 %(builddir)s/tomcat_run_setup.sh %(installdir)s/bin/tomcat_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'TOMCAT_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/tomcat_m3.exe',
        'bin/tomcat_run_setup',
        'tomcat/actor.py',
        'tomcat/tomcat_m3.exe',
        'run_kit/.build_combo',
        'run_kit/tomcat_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libtomcat.a',
        'run_kit/run_tomcat.py',
        'run_kit/input/tomcat.xml',
        'run_kit/ci-sdcc/st03-run-actor.sh',
    ],
    'dirs': ['tomcat/bin', 'tomcat/lib', 'run_kit/ci-sdcc', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from tomcat.actor import tomcat as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/tomcat_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/tomcat_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/tomcat/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit tomcat',
    'tomcat_run_setup --help',
]

moduleclass = 'phys'
