# ASCOT suite (ASCOT4, BBNBI, AFSI, markerSampler, thermalPitchE; MPI) as IMAS libraries, iWrap actors and
# MUSCLE3 actors: DD 4.1.1, toolchain intel/2025b (ifx, Intel MPI), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py; edit the generator, not this file.
easyblock = 'MakeCp'

name = 'ASCOT'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 8ca35d327eca3d2591ef54b9d82cc0bbe61db8f1 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/traj/ascot.git (git describe 4.8.2-34-g8ca35d32); source archive
# ascot-2026.10.22.tar.gz = git archive --prefix=ascot/ of that commit.
local_commit = '8ca35d327eca3d2591ef54b9d82cc0bbe61db8f1'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
local_actors = ['afsi', 'bbnbi_serial', 'bbnbi_parallel', 'ascot_serial', 'ascot_parallel', 'markersampler_serial', 'markersampler_parallel', 'thermalPitchE']

homepage = 'https://git.iter.org/projects/TRAJ/repos/ascot'
description = """ASCOT suite: ASCOT4 fast-ion orbit following, BBNBI beam birth, AFSI fusion source integrator,
markerSampler and thermalPitchE.
Version 2026.10.22 is a date label: built from commit %s (git describe 4.8.2-34-g8ca35d32) of
origin/feature/DD3_and_DD4, for DD %s, optimised, without ASCOT-RFOF: serial and parallel libraries
(lib/serial, lib/parallel), MUSCLE3 actors bin/afsi_m3.exe (serial), bin/bbnbi_m3.exe and bin/ascot_m3.exe
(MPI; copies afsi/afsi_m3.exe, bbnbi_parallel/bbnbi_m3.exe, ascot_parallel/ascot_m3.exe), iWrap actor packages
afsi, bbnbi_serial, bbnbi_parallel, ascot_serial, ascot_parallel, markersampler_serial, markersampler_parallel,
thermalPitchE (on PYTHONPATH), and the run kit run_kit (run_ascot.py, run_muscle, coupling.ymmsl, input,
ci-sdcc); ascot_run_setup <dir> makes a writable run directory from it.""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/traj',
            'repo_name': 'ascot',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'ascot_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'c51d7264951d040ffd0e26381c3045ea9d7886f9b26056be155eb4a6ebc48eeb',
]
start_dir = '%(builddir)s/ascot'

# combination intel-2025b-dd4 of deps.yaml (same order), then Waveform-Cooker
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),
]

# Build environment of ci-sdcc/st00-header.sh + config_sdcc*.sh: no toolchain compiler flags, FC of the
# toolchain, COMBO and IMAS_VERSION of the combination, the identifier library of the env files
local_env = ' && '.join([
    'unset CC CXX F77 F90 FC CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS MPICC MPICXX MPIF77 MPIF90 MPIFC',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
    'export ACCESS_LAYER_DEPENDENT_IDENTIFIERS_LIB=al-identifiers-fortran',
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'
local_nj = '2'

# st01-build-code.sh (NJ=2): pspline, the serial libraries (bbnbi, afsi, ascot) and afsi_m3.exe, then the
# parallel libraries (bbnbi, ascot) and bbnbi_m3.exe, ascot_m3.exe; in addition the markerSampler
# (serial, parallel) and thermalPitchE libraries of build.sh (same make targets, the NO_MPI setting of
# the neighbouring serial / parallel builds)
prebuildopts = ' && '.join([
    local_env,
    'make info',
    'rm -rf actors/serial actors/parallel',
    'mkdir -p actors/serial actors/parallel',
    'rm -f afsi_m3.exe bbnbi_m3.exe ascot_m3.exe',
    'make clean_pspline',
    'make clean_deps',
    'make NO_MPI=yes pspline.a',
    'make clean_deps',
    # serial
    'make NO_MPI=yes actors/bbnbi.a',
    'mv actors/bbnbi.a actors/serial/',
    'cp nbi/libnbi.a mccc/mccc.a idsbbnbimodule.mod actors/serial/',
    'make -j' + local_nj + ' NO_MPI=yes actors/afsiFusionSourceIntegrator.a',
    'mv actors/afsiFusionSourceIntegrator.a actors/serial/',
    'cp idsafsimodule.mod cubpack/CUBPACK/libcubpack.a actors/serial/',
    'make NO_MPI=yes actors/markersamplerserial.a',
    'mv actors/markersamplerserial.a actors/serial/',
    'cp markersamplermodule.mod actors/serial/',
    'make -j' + local_nj + ' NO_MPI=yes actors/ascot4serial.a',
    'mv actors/ascot4serial.a actors/serial/',
    'cp idsascotmodule.mod actors/serial/',
    'make NO_MPI=yes actors/thermalpitche.a',
    'mv actors/thermalpitche.a actors/serial/',
    'cp idsthermalpitchemodule.mod actors/serial/',
    'make NO_MPI=yes m3_serial',
    # parallel
    'make clean_deps',
    'make actors/bbnbiparallel.a',
    'mv actors/bbnbiparallel.a actors/parallel/',
    'cp nbi/libnbi.a mccc/mccc.a idsbbnbimodule.mod actors/parallel/',
    'make actors/markersamplerparallel.a',
    'mv actors/markersamplerparallel.a actors/parallel/',
    'cp markersamplermodule.mod actors/parallel/',
    'make -j' + local_nj + ' actors/ascot4parallel.a',
    'mv actors/ascot4parallel.a actors/parallel/',
    'cp idsascotmodule.mod actors/parallel/',
    'make m3_parallel',
    '',
])
# final make: the build information of the Makefile (compilers, iWrap yaml suffix)
build_cmd_targets = 'info'
maxparallel = 1

files_to_copy = [
    (['actors/serial', 'actors/parallel'], 'lib'),
    (['afsi_m3.exe', 'bbnbi_m3.exe', 'ascot_m3.exe'], 'bin'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # st02-build-actor.sh: one iWrap actor per actor (actors/<actor>_<FC>[_dd3].yaml) in
    # ACTOR_FOLDER=%(installdir)s
    local_env + ' && cd %%(start_dir)s && for a in %s; do make iwrap_actor_$a ACTOR_FOLDER=%%(installdir)s || exit 1; done'
    % ' '.join(local_actors),
    # MUSCLE3 actors next to the iWrap actors of the same library (HCD-WF layout <actor>/<exe>)
    'cp -p %(start_dir)s/afsi_m3.exe %(installdir)s/afsi/'
    ' && cp -p %(start_dir)s/bbnbi_m3.exe %(installdir)s/bbnbi_parallel/'
    ' && cp -p %(start_dir)s/ascot_m3.exe %(installdir)s/ascot_parallel/',
    # run kit: run scripts and inputs of the repository root; the MUSCLE3 executables (coupling.ymmsl)
    # are links to the module
    'mkdir -p ' + local_kit + ' && cd %(start_dir)s'
    ' && cp -p run_ascot.py run_ascot dd_compat.py run_muscle coupling.ymmsl ' + local_kit + '/'
    ' && cp -rp input ci-sdcc ' + local_kit + '/',
    'cd ' + local_kit + ' && chmod a+x run_ascot.py run_ascot run_muscle'
    ' && for e in afsi_m3.exe bbnbi_m3.exe ascot_m3.exe; do ln -sfn %(installdir)s/bin/$e $e; done',
    # build stamp of the combination (read by run_muscle and run_ascot.py through ci-sdcc/build_stamp.sh)
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    'install -m 0755 %(builddir)s/ascot_run_setup.sh %(installdir)s/bin/ascot_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'ASCOT_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (Fortran automatic arrays)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': ['lib/serial/bbnbi.a', 'lib/serial/afsiFusionSourceIntegrator.a', 'lib/serial/ascot4serial.a',
              'lib/serial/markersamplerserial.a', 'lib/serial/thermalpitche.a', 'lib/parallel/bbnbiparallel.a',
              'lib/parallel/ascot4parallel.a', 'lib/parallel/markersamplerparallel.a',
              'bin/afsi_m3.exe', 'bin/bbnbi_m3.exe', 'bin/ascot_m3.exe', 'bin/ascot_run_setup',
              'afsi/afsi_m3.exe', 'bbnbi_parallel/bbnbi_m3.exe', 'ascot_parallel/ascot_m3.exe',
              'run_kit/run_ascot.py', 'run_kit/run_muscle', 'run_kit/coupling.ymmsl', 'run_kit/.build_combo',
              'run_kit/ascot_m3.exe', 'run_kit/ci-sdcc/st03-run-actor.sh'] +
             ['%s/actor.py' % a for a in local_actors],
    'dirs': ['run_kit/input', 'run_kit/ci-sdcc/st03-input'],
}

sanity_check_commands = ["python -c 'from %s.actor import %s'" % (a, a) for a in local_actors] + [
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
] + ["! ldd %%(installdir)s/bin/%s | grep 'not found'" % e for e in ('afsi_m3.exe', 'bbnbi_m3.exe', 'ascot_m3.exe')] + [
    "ldd %(installdir)s/bin/ascot_m3.exe | grep -q libmuscle_mpi",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit ascot',
    'ascot_run_setup --help',
]

moduleclass = 'phys'
