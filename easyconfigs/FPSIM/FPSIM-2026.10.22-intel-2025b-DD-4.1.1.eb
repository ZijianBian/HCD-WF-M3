# FPSIM (IC antenna coupling ICCOUP) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 4.1.1, toolchain intel/2025b (ifx), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'FPSIM'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 821b314b3a5dbc2fd4f208973b984d7045db2e9e of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/fpsim.git (git describe 1.0.0-2-g821b314); source archive
# fpsim-2026.10.22.tar.gz = git archive --prefix=fpsim/ of that commit.
local_commit = '821b314b3a5dbc2fd4f208973b984d7045db2e9e'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: tools/iccoup_ifx.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/fpsim'
description = """FPSIM fast particle simulation tools: ICCOUP ion cyclotron antenna coupling (toroidal mode spectrum).
Version 2026.10.22 is a date label: built from commit %s (git describe 1.0.0-2-g821b314) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): ICCOUP Fortran library (lib/libiccoup_debug.a, include/iccoup), MUSCLE3 actor executable (bin/iccoup_m3.exe, also iccoup/iccoup_m3.exe), iWrap actor package iccoup (on PYTHONPATH), and the run kit run_kit (run_iccoup.py, run_muscle, coupling.ymmsl, tools/iccoup/input, ci-sdcc/st03-run-actor.sh). Built with DEBUG=yes as ci-sdcc/st01 + st02 (the committed iWrap yamls use the debug library); the build runs the standalone check prog_ids_iccoup.exe of st01.
fpsim_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load FPSIM/2026.10.22-intel-2025b-DD-4.1.1
fpsim_run_setup <dir> && cd <dir>
bash ci-sdcc/st03-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on ITER 130012/4 t=200 s, ITER_MD 110000/2, checks (ST03_DIR, default ./ci-st03)
python run_iccoup.py    # iWrap actor (ICCOUP_INPUT_URI, ICCOUP_MD_URI, ICCOUP_TIME, ICCOUP_OUTPUT_URI)
./run_muscle            # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTFPSIM ($ACTOR_FOLDER/iccoup/iccoup_m3.exe; actor package iccoup on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'fpsim',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'fpsim_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'b74abdaae64cb3d94fddd710746270804e7fc46871c367a341711c42691a12fc',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/fpsim'


# combination intel-2025b-dd4 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh (DEBUG=yes, with the standalone check)
local_build_cmds = [
    'make -C tools/iccoup/ DEBUG=yes veryclean library FC="$FC"',
    'make -C tools/iccoup/ DEBUG=yes check FC="$FC"',
    'make -C tools/iccoup/ DEBUG=yes m3 FC="$FC"',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['tools/iccoup/iccoup_m3.exe'], 'bin'),
    (['tools/iccoup/lib/ifx_debug/libiccoup_debug.a'], 'lib'),
    (['tools/iccoup/obj/ifx_debug/*.mod'], 'include/iccoup'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/tools/iccoup && cp -p %(start_dir)s/tools/iccoup/iccoup_m3.exe ' + local_kit + '/tools/iccoup/iccoup_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/iccoup (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make -C tools/iccoup/ DEBUG=yes iwrap_actor FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/iccoup/iccoup_m3.exe)
    'cp -p %(installdir)s/bin/iccoup_m3.exe %(installdir)s/iccoup/iccoup_m3.exe',
    'install -m 0755 %(builddir)s/fpsim_run_setup.sh %(installdir)s/bin/fpsim_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'FPSIM_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/iccoup_m3.exe',
        'bin/fpsim_run_setup',
        'iccoup/actor.py',
        'iccoup/iccoup_m3.exe',
        'run_kit/.build_combo',
        'run_kit/tools/iccoup/iccoup_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libiccoup_debug.a',
        'run_kit/run_iccoup.py',
        'run_kit/tools/iccoup/input/input_iccoup.xml',
        'run_kit/ci-sdcc/st03-run-actor.sh',
    ],
    'dirs': ['iccoup/bin', 'iccoup/lib', 'run_kit/ci-sdcc', 'run_kit/tools/iccoup/input'],
}

sanity_check_commands = [
    "python -c 'from iccoup.actor import iccoup as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/iccoup_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/iccoup_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/iccoup/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit fpsim',
    'fpsim_run_setup --help',
]

moduleclass = 'phys'
