# TORIC as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'TORIC'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 43393d2cfdabfc8e69e2cc51bee1f85cfb689349 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/toric.git (git describe before_ggd_generalisation-4-g43393d2); source archive
# toric-2026.10.22.tar.gz = git archive --prefix=toric/ of that commit.
local_commit = '43393d2cfdabfc8e69e2cc51bee1f85cfb689349'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/toric'
description = """TORIC full-wave ICRF code (ion cyclotron wave propagation and absorption).
Version 2026.10.22 is a date label: built from commit %s (git describe before_ggd_generalisation-4-g43393d2) of
origin/feature/DD3_and_DD4, for DD %s: library libtoric.a and the in-tree GGD library libimas_ggd.a (lib, include/toric),
MUSCLE3 actor executable (bin/toric_m3.exe, also toric/toric_m3.exe), iWrap actor package
toric (on PYTHONPATH) and the run kit (run_toric.py, run_muscle, coupling.ymmsl, xml, input,
ci-sdcc/st03-run-actor.sh; without tests/ and doc/);
toric_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'toric',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'toric_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '3788f8fb62f4afa67f14bc3e98fefcff03f72cbb9a113139234ad6d448316909',
]
start_dir = '%(builddir)s/toric'

# combination intel-2025b-dd3 of deps.yaml (same order), then the Waveform-Cooker component
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2025b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2025b
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),  # IMAS-Fortran/5.6.0-intel-2025b-DD-3.42.2
    ('MUSCLE3', '0.10.0'),  # MUSCLE3/0.10.0-intel-2025b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),  # XMLlib/3.3.2-intel-compilers-2025.2.0
    ('netCDF-Fortran', '4.6.2', '', ('iimpi', '2025b')),  # netCDF-Fortran/4.6.2-iimpi-2025b
    ('imkl-FFTW', '2025.2.0', '', ('iimpi', '2025b')),  # imkl-FFTW/2025.2.0-iimpi-2025b
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),  # Waveform-Cooker/1.9.0-GCCcore-14.3.0
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifx IMAS_VERSION=3.42.2 COMBO=intel-2025b-dd3'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make veryclean, make library (libtoric.a, grid_library), then make m3 (toric_m3.exe); OPT= keeps -fast off
prebuildopts = local_env + ' && make veryclean OPT= && make library OPT= &&'
build_cmd = 'make'
build_cmd_targets = 'm3'
buildopts = 'OPT='
maxparallel = 1

files_to_copy = [
    (['toric_m3.exe'], 'bin'),
    (['bin/Linux/Ser/libtoric.a', 'grid_library/ifx/lib/libimas_ggd.a'], 'lib'),
    (['bin/Linux/Ser/*.mod'], 'include/toric'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/toric (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make actor OPT= ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/toric_m3.exe %(installdir)s/toric/toric_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by toric_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps --exclude=./tests --exclude=./doc -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'toric toric\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/toric_run_setup.sh %(installdir)s/bin/toric_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '3.42.2',
    'COMBO': 'intel-2025b-dd3',
    'TORIC_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/toric_m3.exe',
        'bin/toric_run_setup',
        'lib/libtoric.a',
        'lib/libimas_ggd.a',
        'include/toric/t6_mod_itmtoric.mod',
        'toric/actor.py',
        'toric/bin/toric_main.exe',
        'toric/lib/libtoric.so',
        'toric/toric_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/toric_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/bin/Linux/Ser/libtoric.a',
        'run_kit/grid_library/ifx/lib/libimas_ggd.a',
        'run_kit/run_toric.py',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/xml/toricainp.xml',
    ],
    'dirs': ['toric/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from toric.actor import toric as a; print(a)'",
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/toric_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/toric/bin/toric_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/toric_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit toric',
    'toric_run_setup --help',
]

moduleclass = 'phys'
