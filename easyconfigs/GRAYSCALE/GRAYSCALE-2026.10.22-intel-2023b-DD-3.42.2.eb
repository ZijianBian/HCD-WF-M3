# GRAYSCALE (EC current drive scaling) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2023b (ifort), combination intel-2023b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'GRAYSCALE'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 9515ef3893aa9acf9f1aa0802881ab449c7f1bee of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/grayscale.git (git describe 1.1.0-18-g9515ef3); source archive
# grayscale-2026.10.22.tar.gz = git archive --prefix=grayscale/ of that commit.
local_commit = '9515ef3893aa9acf9f1aa0802881ab449c7f1bee'
local_combo = 'intel-2023b-dd3'
local_fc = 'ifort'
# iWrap yaml picked by the Makefile from FC and the DD major version: grayscale_ifort_dd3.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/grayscale'
description = """GRAYSCALE: fast EC heating and current drive deposition from GRAY-based scaling laws.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.1.0-18-g9515ef3) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): Fortran library (lib/libgrayscale_debug.a, include/grayscale), MUSCLE3 actor executable (bin/grayscale_m3.exe, also grayscale/grayscale_m3.exe), iWrap actor package grayscale (on PYTHONPATH), and the run kit run_kit (run_grayscale.py, run_muscle, coupling.ymmsl, input/, ci-sdcc/st03-run-actor.sh). Built with DEBUG=yes as ci-sdcc/st01 + st02 (the committed iWrap yamls use the debug library).
grayscale_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load GRAYSCALE/2026.10.22-intel-2023b-DD-3.42.2
grayscale_run_setup <dir> && cd <dir>
bash ci-sdcc/st03-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on ITER 130012/5, checks (ST03_DIR, default ./ci-st03)
python run_grayscale.py --src <uri> --dest <uri> --time <t>   # iWrap actor
./run_muscle            # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTGRAYSCALE ($ACTOR_FOLDER/grayscale/grayscale_m3.exe; actor package grayscale on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2023b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'grayscale',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'grayscale_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'a6a014278a4fac5b1f203f066a321a97aa5569b12fd2fa406334ae2fd19b91d1',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/grayscale'


# combination intel-2023b-dd3 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),
    ('MUSCLE3', '0.8.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2023.2.1')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh (DEBUG=yes)
local_build_cmds = [
    'make clean library FC="$FC" DEBUG=yes',
    'make m3 FC="$FC" DEBUG=yes',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['grayscale_m3.exe'], 'bin'),
    (['lib/ifort_debug/libgrayscale_debug.a'], 'lib'),
    (['obj/ifort_debug/*.mod'], 'include/grayscale'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/. && cp -p %(start_dir)s/grayscale_m3.exe ' + local_kit + '/grayscale_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/grayscale (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make iwrap_actor FC="$FC" DEBUG=yes ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/grayscale/grayscale_m3.exe)
    'cp -p %(installdir)s/bin/grayscale_m3.exe %(installdir)s/grayscale/grayscale_m3.exe',
    'install -m 0755 %(builddir)s/grayscale_run_setup.sh %(installdir)s/bin/grayscale_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'GRAYSCALE_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/grayscale_m3.exe',
        'bin/grayscale_run_setup',
        'grayscale/actor.py',
        'grayscale/grayscale_m3.exe',
        'run_kit/.build_combo',
        'run_kit/grayscale_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libgrayscale_debug.a',
        'run_kit/run_grayscale.py',
        'run_kit/input/input_file.xml',
        'run_kit/ci-sdcc/st03-run-actor.sh',
    ],
    'dirs': ['grayscale/bin', 'grayscale/lib', 'run_kit/ci-sdcc', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from grayscale.actor import grayscale as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/grayscale_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/grayscale_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/grayscale/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit grayscale',
    'grayscale_run_setup --help',
]

moduleclass = 'phys'
