# SPOT (Monte Carlo fast-ion code, MPI) as IMAS library, iWrap actor and MUSCLE3 actor: DD 3.42.2,
# toolchain intel/2023b (ifort, Intel MPI), combination intel-2023b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py; edit the generator, not this file.
easyblock = 'MakeCp'

name = 'SPOT'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 1ec39ddd8f793cca162b74d621c7777bdb7bffb6 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/spot.git (git describe 2.4.0-15-g1ec39dd); source archive
# spot-2026.10.22.tar.gz = git archive --prefix=spot/ of that commit.
local_commit = '1ec39ddd8f793cca162b74d621c7777bdb7bffb6'
local_combo = 'intel-2023b-dd3'
local_fc = 'ifort'

homepage = 'https://git.iter.org/projects/HEAT/repos/spot'
description = """SPOT: Monte Carlo orbit-following code for NBI and fusion-born fast ions (MPI).
Version 2026.10.22 is a date label: built from commit %s (git describe 2.4.0-15-g1ec39dd) of
origin/feature/DD3_and_DD4, for DD %s, with FRUIT tests and without RFOF: library (lib, include/spot), MPI
MUSCLE3 actor bin/spot_m3.exe (also spot/spot_m3.exe), iWrap actor package spot (on PYTHONPATH), and the run
kit run_kit (run_spot, run_muscle, coupling.ymmsl, input, ci-sdcc); spot_run_setup <dir> makes a writable
run directory from it.""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2023b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'spot',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'spot_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'df0115105eb6f76f334905b9c1ecd8d355b0ddafbf3e4240dce472414ea4d046',
]
start_dir = '%(builddir)s/spot'

# combination intel-2023b-dd3 of deps.yaml (same order), then Waveform-Cooker
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),
    ('IDStools', '2.5.0'),
    ('MUSCLE3', '0.8.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2023.2.1')),
    ('INTERPOS', '9.2.0', '', ('iimkl', '2023b')),
    ('PSPLINE', '2.0.1', '', ('iimpi', '2023b')),
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '13.2.0')),
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination
local_env = ' && '.join([
    'unset CC CXX F77 F90 FC CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS MPICC MPICXX MPIF77 MPIF90 MPIFC',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'
local_make_opts = 'USE_FRUIT=yes FCOMPILER=%s RFOF_FLAG=0' % local_fc

# st01-build-code.sh: library (with the in-tree grid_library), then the MPI MUSCLE3 actor spot_m3.exe
prebuildopts = ' && '.join([
    local_env,
    'make clean library ' + local_make_opts,
    '',
])
buildopts = local_make_opts
build_cmd_targets = 'm3'
# the Makefile archives obj_<FC>/*.o: serial build
maxparallel = 1

files_to_copy = [
    (['obj_%s/libspot.a' % local_fc], 'lib'),
    (['obj_%s/*.mod' % local_fc], 'include/spot'),
    (['spot_m3.exe'], 'bin'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # st02-build-actor.sh: iWrap actor (yaml per FC and DD) in ACTOR_FOLDER=%(installdir)s, with a copy of
    # the MUSCLE3 actor (spot/spot_m3.exe)
    local_env + ' && cd %(start_dir)s && make actor ' + local_make_opts + ' ACTOR_FOLDER=%(installdir)s',
    'cp -p %(start_dir)s/spot_m3.exe %(installdir)s/spot/',
    # run kit: run scripts and inputs of the repository root; spot_m3.exe (coupling.ymmsl) and the actor
    # package ./spot (ci-sdcc/st03-run-actor.sh) are links to the module
    'mkdir -p ' + local_kit + ' && cd %(start_dir)s'
    ' && cp -p run_spot run_spotcode run_muscle coupling.ymmsl dd_compat.py time_compute.py build.sh ' + local_kit + '/'
    ' && cp -rp input ci-sdcc ' + local_kit + '/',
    'cd ' + local_kit + ' && chmod a+x run_spot run_spotcode run_muscle build.sh'
    ' && ln -sfn %(installdir)s/bin/spot_m3.exe spot_m3.exe'
    ' && ln -sfn %(installdir)s/spot spot',
    # build stamp of the combination (read by run_muscle through ci-sdcc/build_stamp.sh)
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    'install -m 0755 %(builddir)s/spot_run_setup.sh %(installdir)s/bin/spot_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'SPOT_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (Fortran automatic arrays)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': ['lib/libspot.a', 'bin/spot_m3.exe', 'bin/spot_run_setup', 'spot/actor.py', 'spot/spot_m3.exe',
              'run_kit/run_spot', 'run_kit/run_muscle', 'run_kit/coupling.ymmsl', 'run_kit/.build_combo',
              'run_kit/spot_m3.exe', 'run_kit/ci-sdcc/st03-run-actor.sh', 'run_kit/ci-sdcc/st05-run-actor.sh'],
    'dirs': ['include/spot', 'run_kit/input', 'spot/input'],
}

sanity_check_commands = [
    "python -c 'from spot.actor import spot'",
    "python -c 'import waveform_cooker, idstools, scipy, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/spot_m3.exe | grep 'not found'",
    "ldd %(installdir)s/bin/spot_m3.exe | grep -q libmuscle_mpi",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit spot',
    'spot_run_setup --help',
]

moduleclass = 'phys'
