# FoPla as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 4.1.1, toolchain intel/2025b (ifx), combination intel-2025b-dd4 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'FoPla'
version = '2026.10.22'
local_dd = '4.1.1'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 15054541d658958bef9079860243c251267ede8d of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/fopla.git (git describe 2.1.0-32-g1505454); source archive
# fopla-2026.10.22.tar.gz = git archive --prefix=fopla/ of that commit.
local_commit = '15054541d658958bef9079860243c251267ede8d'
local_combo = 'intel-2025b-dd4'
local_fc = 'ifx'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/fopla'
description = """FoPla: Fokker-Planck solver for ICRF/NBI fast-ion distributions.
Version 2026.10.22 is a date label: built from commit %s (git describe 2.1.0-32-g1505454) of
origin/feature/DD3_and_DD4, for DD %s: library libFoPla_icrh_ids.a (lib), MUSCLE3 actor executable (bin/fopla_m3.exe, also
fopla/fopla_m3.exe), iWrap actor package fopla (on PYTHONPATH) and the run kit (run_fopla,
run_muscle, coupling.ymmsl, input, ci-sdcc/st03-run-actor.sh with its test entry
ci-sdcc/st03-imasdb);
fopla_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'fopla',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'fopla_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    'cf7a653e671d069c88c5d804d9193c44d8dcd7627956ecad996ec1b858fd4f7b',
]
start_dir = '%(builddir)s/fopla'

# combination intel-2025b-dd4 of deps.yaml (same order), then the Waveform-Cooker component
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2025b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2025b
    ('IMAS-Fortran', '5.6.0', '-DD-4.1.1'),  # IMAS-Fortran/5.6.0-intel-2025b-DD-4.1.1
    ('MUSCLE3', '0.10.0'),  # MUSCLE3/0.10.0-intel-2025b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),  # XMLlib/3.3.2-intel-compilers-2025.2.0
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),  # Waveform-Cooker/1.9.0-GCCcore-14.3.0
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifx IMAS_VERSION=4.1.1 COMBO=intel-2025b-dd4'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make veryclean validate clean library DEBUG=yes, then make m3 DEBUG=yes (fopla_m3.exe)
prebuildopts = local_env + ' && make veryclean validate clean library DEBUG=yes FC="$FC" &&'
build_cmd = 'make'
build_cmd_targets = 'm3'
buildopts = 'DEBUG=yes FC="$FC"'
maxparallel = 1

files_to_copy = [
    (['fopla_m3.exe'], 'bin'),
    (['BUILD/debug/lib/libFoPla_icrh_ids.a'], 'lib'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/fopla (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make iwrap_actor DEBUG=yes FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/fopla_m3.exe %(installdir)s/fopla/fopla_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by fopla_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'fopla fopla\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/fopla_run_setup.sh %(installdir)s/bin/fopla_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '4.1.1',
    'COMBO': 'intel-2025b-dd4',
    'FOPLA_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/fopla_m3.exe',
        'bin/fopla_run_setup',
        'lib/libFoPla_icrh_ids.a',
        'fopla/actor.py',
        'fopla/bin/fopla_main.exe',
        'fopla/lib/libfopla.so',
        'fopla/fopla_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/fopla_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/BUILD/debug/lib/libFoPla_icrh_ids.a',
        'run_kit/run_fopla',
        'run_kit/ci-sdcc/st03-run-actor.sh',
        'run_kit/ci-sdcc/st03-scenario.yaml',
        'run_kit/ci-sdcc/st03-imasdb/ITER/4/130012/100/master.h5',
        'run_kit/input/input_FoPla_icrh_only.xml',
    ],
    'dirs': ['fopla/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from fopla.actor import fopla as a; print(a)'",
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/fopla_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/fopla/bin/fopla_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/fopla_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit fopla',
    'fopla_run_setup --help',
]

moduleclass = 'phys'
