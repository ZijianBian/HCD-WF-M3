# TORBEAM (EC beam tracing) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of tests/test_imas/deps.yaml.
# Generated by gen_easyconfigs.py; edit the generator, not this file.
easyblock = 'MakeCp'

name = 'TORBEAM'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 6bac997a7edb00d935f21263ac3eb118ccbf4311 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/torbeam.git (git describe 3.8.0-183-g6bac997); source archive
# torbeam-2026.10.22.tar.gz = git archive --prefix=torbeam/ of that commit.
local_commit = '6bac997a7edb00d935f21263ac3eb118ccbf4311'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
local_iwrap_yaml = 'torbeam_ifx_dd3.yaml'
# run kit folder of this Data Dictionary inside test_imas ('' DD4 tree, 'dd3' DD3 tree)
local_tree = 'dd3'

homepage = 'https://git.iter.org/projects/HEAT/repos/torbeam'
description = """TORBEAM beam-tracing code for electron cyclotron heating and current drive.
Version 2026.10.22 is a date label: built from commit %s (git describe 3.8.0-183-g6bac997) of
origin/feature/DD3_and_DD4, for DD %s: Fortran library (lib, include/torbeam), MUSCLE3 actor executable
(bin/torbeam_m3.exe, also torbeam/torbeam_m3.exe), iWrap actor package torbeam (on PYTHONPATH),
and the run kit test_imas (run_torbeam, run_muscle, input, ymmsl); torbeam_run_setup <dir> makes a
writable run directory from it.""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2025b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'torbeam',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'torbeam_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '3a1c6b80bf269f92236a9f6ef39def9aecfcf99177a568cddb4c7edb7b3fd7f3',
]
start_dir = '%(builddir)s/torbeam'

builddependencies = [
    ('CMake', '3.31.8', '', ('GCCcore', '14.3.0')),
]

# combination intel-2025b-dd3 of tests/test_imas/deps.yaml (same order), then Waveform-Cooker
dependencies = [
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),
    ('iWrap', '2.0.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
    ('INTERPOS', '9.2.3', '', ('iimkl', '2025b')),
    ('MUSCLE3', '0.10.0'),
    ('Waveform-Cooker', '1.10.0', '', ('GCCcore', '14.3.0')),
]

# Same build environment as ci-sdcc/st00-header.sh + st01-build-code.sh: no toolchain compiler
# flags, FC of the toolchain, COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# st01-build-code.sh: cmake of the repository root from tests/test_imas/build, then the IMAS
# library and the MUSCLE3 executable
prebuildopts = ' && '.join([
    local_env,
    'cd tests/test_imas/build',
    'cmake ../../.. -DUSE_PERF=ON -DUSE_LAGR_INTERPOL=ON -DUSE_XHOST=ON -DUSE_OPENMP=ON',
    '',
])
build_cmd_targets = 'torbeam_imas torbeam_m3.exe'
maxparallel = 4

files_to_copy = [
    (['tests/test_imas/build/bin/torbeam_m3.exe'], 'bin'),
    (['tests/test_imas/build/lib/libtorbeam_imas.a'], 'lib'),
    (['tests/test_imas/build/lib/*.mod'], 'include/torbeam'),
]

local_kit = '%(installdir)s/test_imas'
postinstallcmds = [
    # run kit: tracked files of tests/test_imas, with the build products in test_imas/build
    'mkdir -p ' + local_kit + '/build/bin && cd %(start_dir)s/tests/test_imas'
    ' && tar --exclude=./build -cf - . | tar -xf - -C ' + local_kit,
    'cd %(start_dir)s/tests/test_imas/build'
    ' && cp -p README.txt build_imas.sh CMakeLists_debug.txt torbeam_gfortran.yaml torbeam_ifx.yaml'
    ' torbeam_ifx_dd3.yaml torbeam_ifort_dd3.yaml ' + local_kit + '/build/'
    ' && cp -rp fc2k lib ' + local_kit + '/build/'
    ' && cp -p bin/torbeam_m3.exe ' + local_kit + '/build/bin/',
    'cd ' + local_kit + ' && chmod a+x ecplot ecstray ecray run_torbeam run_torbeam_batch run_reconstruction'
    ' create_sum2ec run_muscle build/build_imas.sh dd3/run_torbeam dd3/run_muscle dd3/transport_suite_emulator',
    # build stamp of the combination (read by run_torbeam / run_muscle through ci-sdcc/build_stamp.sh)
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write build',
    # iWrap actor package %(installdir)s/torbeam (st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd ' + local_kit + '/build && iwrap -f ' + local_iwrap_yaml + ' -i %(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/torbeam/torbeam_m3.exe)
    'cp -p ' + local_kit + '/build/bin/torbeam_m3.exe %(installdir)s/torbeam/torbeam_m3.exe',
    'mkdir -p %(installdir)s/torbeam/doc'
    ' && cp -p %(start_dir)s/doc/input-output.pdf %(start_dir)s/doc/input-output.tex %(installdir)s/torbeam/doc/',
    'install -m 0755 %(builddir)s/torbeam_run_setup.sh %(installdir)s/bin/torbeam_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'IMAS_AL_DISABLE_VALIDATE': '1',
    'TORBEAM_RUN_KIT': local_kit + ('/' + local_tree if local_tree else ''),
}
# stack limit of config_sdcc*.sh (Fortran automatic arrays)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/torbeam_m3.exe', 'bin/torbeam_run_setup', 'lib/libtorbeam_imas.a', 'include/torbeam/torbeam_iwrap.mod',
        'torbeam/actor.py', 'torbeam/lib/libtorbeam.so', 'torbeam/bin/torbeam_main.exe', 'torbeam/torbeam_m3.exe',
        'torbeam/doc/input-output.pdf',
        'test_imas/build/.build_combo', 'test_imas/build/bin/torbeam_m3.exe', 'test_imas/build/lib/libtorbeam_imas.a',
        'test_imas/run_torbeam', 'test_imas/run_muscle', 'test_imas/dd3/run_torbeam', 'test_imas/dd3/run_muscle',
        'test_imas/ci-sdcc/build_stamp.sh',
    ],
    'dirs': ['torbeam/input', 'test_imas/input', 'test_imas/ymmsl', 'test_imas/dd3/input', 'test_imas/dd3/ymmsl'],
}

sanity_check_commands = [
    "python -c 'from torbeam.actor import torbeam as torbeam_actor; print(torbeam_actor)'",
    "python -c 'import waveform_cooker, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/torbeam_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/torbeam/bin/torbeam_main.exe | grep 'not found'",
    "ldd %(installdir)s/bin/torbeam_m3.exe | grep -q libmuscle",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/test_imas/ci-sdcc/build_stamp.sh check %(installdir)s/test_imas/build torbeam',
    'torbeam_run_setup --help',
]

moduleclass = 'phys'
