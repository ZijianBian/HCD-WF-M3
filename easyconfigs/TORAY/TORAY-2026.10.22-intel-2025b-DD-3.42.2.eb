# TORAY (EC ray tracing) as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2025b (ifx), combination intel-2025b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'TORAY'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 13c359b20b49cc6e5a02a69a33bc3061095a1720 of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/toray.git (git describe 1.0.0-17-g13c359b); source archive
# toray-2026.10.22.tar.gz = git archive --prefix=toray/ of that commit.
local_commit = '13c359b20b49cc6e5a02a69a33bc3061095a1720'
local_combo = 'intel-2025b-dd3'
local_fc = 'ifx'
# iWrap yaml picked by the Makefile from FC and the DD major version: toray_ifx_dd3.yaml

homepage = 'https://git.iter.org/projects/HEAT/repos/toray'
description = """TORAY ray-tracing code for electron cyclotron heating and current drive.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.0.0-17-g13c359b) of
origin/feature/DD3_and_DD4, for DD %s (combination %s, %s): Fortran library (lib/libtoray.a with lib/libnag.a, lib/libnet.a, include/toray), MUSCLE3 actor executable (bin/toray_m3.exe, also toray/toray_m3.exe), iWrap actor package toray (on PYTHONPATH), and the run kit run_kit (run_toray.py, run_muscle, coupling.ymmsl, input/, ci-sdcc/st03-run-actor.sh).
toray_run_setup <dir> makes a writable run directory from the run kit.""" % (local_commit, local_dd, local_combo, local_fc)

usage = """module load TORAY/2026.10.22-intel-2025b-DD-3.42.2
toray_run_setup <dir> && cd <dir>
bash ci-sdcc/st03-run-actor.sh   # CI case: iWrap + MUSCLE3 actor on ITER 134173/106 t=200 s, checks (ST03_DIR, default ./ci-st03)
python run_toray.py     # iWrap actor (input/scenario[_dd3].yaml)
./run_muscle            # MUSCLE3 actor (coupling.ymmsl)
HCD-WF layout: ACTOR_FOLDER=$EBROOTTORAY ($ACTOR_FOLDER/toray/toray_m3.exe; actor package toray on PYTHONPATH)"""

toolchain = {'name': 'intel', 'version': '2025b'}
# no -xHost/-march: the module is shared by all node types; the code's own flags are used (local_env)
toolchainopts = {'optarch': False}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'toray',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'toray_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
    {
        'filename': 'resolve_deps_module.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '49b2def64a724d5c8ee05579274749b29936d8044cfd35ad7219a7eee511f8fd',
    '9d509eda07690e8d76dca5104df5bbe442ea2f101612dcb670dae90fce10d564',
]
start_dir = '%(builddir)s/toray'


# combination intel-2025b-dd3 of deps.yaml (same order), then Waveform-Cooker (official 1.10.0 for DD4 where deps.yaml names the user build 14.4.0.dev1: mirror steering ec_mirror_add_dynamic; 1.9.0 as in deps.yaml for DD3)
dependencies = [
    ('iWrap', '2.0.0'),
    ('IMAS-Python', '2.3.0'),
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),
    ('MUSCLE3', '0.10.0'),
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2025.2.0')),
    ('Waveform-Cooker', '1.9.0', '', ('GCCcore', '14.3.0')),
]

# Same build environment as ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = ' && '.join([
    'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS',
    'export FC=%s COMBO=%s IMAS_VERSION=%s' % (local_fc, local_combo, local_dd),
])
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# pristine copy of the source tree (run kit), then the commands of ci-sdcc/st01-build-code.sh
local_build_cmds = [
    'make -f make/makefile_imas clean FC="$FC"',
    'make -j1 -f make/makefile_imas validate libtoray.a FC="$FC"',
    'make -j1 -f make/makefile_imas m3 FC="$FC"',
]
prebuildopts = ' && '.join([
    local_env,
    'rm -rf %(builddir)s/run_kit_src && cp -a %(start_dir)s %(builddir)s/run_kit_src',
] + local_build_cmds + [''])
# build stamp of the combination (read by run_muscle and the ci-sdcc scripts through ci-sdcc/build_stamp.sh)
build_cmd = 'bash'
buildopts = 'ci-sdcc/build_stamp.sh write .'
maxparallel = 1

files_to_copy = [
    (['toray_m3.exe'], 'bin'),
    (['libtoray.a', 'lib/libnag.a', 'lib/libnet.a'], 'lib'),
    (['obj/*.mod'], 'include/toray'),
]

local_kit = '%(installdir)s/run_kit'
postinstallcmds = [
    # run kit: tracked files of the repository at the commit, the build products and the build stamp
    'cp -a %(builddir)s/run_kit_src ' + local_kit,
    'mkdir -p ' + local_kit + '/. && cp -p %(start_dir)s/toray_m3.exe ' + local_kit + '/toray_m3.exe',
    'cp -p %(start_dir)s/.build_combo ' + local_kit + '/.build_combo',
    'install -m 0644 %(builddir)s/resolve_deps_module.sh ' + local_kit + '/ci-sdcc/resolve_deps.sh',
    # iWrap actor package %(installdir)s/toray (ci-sdcc/st02-build-actor.sh with ACTOR_FOLDER=%(installdir)s)
    local_env + ' && cd %(start_dir)s && export ACTOR_FOLDER=%(installdir)s && make -j1 -f make/makefile_imas iwrapactor FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable where HCD-WF expects it ($ACTOR_FOLDER/toray/toray_m3.exe)
    'cp -p %(installdir)s/bin/toray_m3.exe %(installdir)s/toray/toray_m3.exe',
    'install -m 0755 %(builddir)s/toray_run_setup.sh %(installdir)s/bin/toray_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': local_dd,
    'COMBO': local_combo,
    'TORAY_RUN_KIT': local_kit,
}
# stack limit of config_sdcc*.sh (ulimit -Ss unlimited)
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/toray_m3.exe',
        'bin/toray_run_setup',
        'toray/actor.py',
        'toray/toray_m3.exe',
        'run_kit/.build_combo',
        'run_kit/toray_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'lib/libtoray.a',
        'run_kit/run_toray.py',
        'run_kit/ci-sdcc/st03-scenario.yaml',
        'run_kit/ci-sdcc/st03-run-actor.sh',
    ],
    'dirs': ['toray/bin', 'toray/lib', 'run_kit/ci-sdcc', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from toray.actor import toray as actor; print(actor)'",
    "python -c 'import ymmsl, libmuscle'",
    "python -c 'from waveform_cooker import add_dynamic, ec_add_dynamic'",
    "! ldd %(installdir)s/bin/toray_m3.exe | grep 'not found'",
    'ldd %(installdir)s/bin/toray_m3.exe | grep -q libmuscle',
    "for f in %(installdir)s/toray/bin/*.exe; do ! ldd $f | grep 'not found' || exit 1; done",
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit toray',
    'toray_run_setup --help',
]

moduleclass = 'phys'
