# HCD2CORE_SOURCES as IMAS library, iWrap actor and MUSCLE3 actor:
# DD 3.42.2, toolchain intel/2023b (ifort), combination intel-2023b-dd3 of deps.yaml.
# Generated by gen_easyconfigs.py (with ../_lib/hcd_ec.py); edit the generator, not this file.
easyblock = 'MakeCp'

name = 'HCD2CORE_SOURCES'
version = '2026.10.22'
local_dd = '3.42.2'
versionsuffix = '-DD-%s' % local_dd

# Version 2026.10.22 (date label) = commit 47808226d4e429b254c84cd614bbcd75bc50f26d of origin/feature/DD3_and_DD4,
# ssh://git@git.iter.org/heat/hcd2core-sources.git (git describe 1.2.0-34-g4780822); source archive
# hcd2core_sources-2026.10.22.tar.gz = git archive --prefix=hcd2core-sources/ of that commit.
local_commit = '47808226d4e429b254c84cd614bbcd75bc50f26d'
local_combo = 'intel-2023b-dd3'
local_fc = 'ifort'
local_kit = '%(installdir)s/run_kit'

homepage = 'https://git.iter.org/projects/HEAT/repos/hcd2core-sources'
description = """hcd2core_sources: conversion of waves, distributions and distribution_sources into core_sources.
Version 2026.10.22 is a date label: built from commit %s (git describe 1.2.0-34-g4780822) of
origin/feature/DD3_and_DD4, for DD %s: library libhcd2core_sources.a (lib, include/hcd2core_sources), MUSCLE3 actor executable
(bin/hcd2core_sources_m3.exe, also hcd2core_sources/hcd2core_sources_m3.exe, the path used by
HCD-WF), iWrap actor package hcd2core_sources (on PYTHONPATH) and the run kit
(run_hcd2core_sources.py, run_muscle, coupling.ymmsl, input);
hcd2core_sources_run_setup <dir> makes a writable run directory from the run kit (run_kit).""" % (local_commit, local_dd)

toolchain = {'name': 'intel', 'version': '2023b'}

sources = [
    {
        'git_config': {
            'url': 'ssh://git@git.iter.org/heat',
            'repo_name': 'hcd2core-sources',
            'commit': local_commit,
        },
        'filename': '%(namelower)s-%(version)s.tar.gz',
    },
    {
        'filename': 'hcd2core_sources_run_setup.sh',
        'extract_cmd': 'cp %s .',
    },
]
checksums = [
    None,
    '4973a15a2afb45ee3afc84f28aaf22d1fa972b78951fb9a7888d6e1c73d7e4aa',
]
start_dir = '%(builddir)s/hcd2core-sources'

# combination intel-2023b-dd3 of deps.yaml (same order)
dependencies = [
    ('iWrap', '2.0.0'),  # iWrap/2.0.0-intel-2023b
    ('IMAS-Python', '2.3.0'),  # IMAS-Python/2.3.0-intel-2023b
    ('IMAS-Fortran', '5.6.0', '-DD-3.42.2'),  # IMAS-Fortran/5.6.0-intel-2023b-DD-3.42.2
    ('IDStools', '2.5.0'),  # IDStools/2.5.0-intel-2023b
    ('MUSCLE3', '0.8.0'),  # MUSCLE3/0.8.0-intel-2023b
    ('XMLlib', '3.3.2', '', ('intel-compilers', '2023.2.1')),  # XMLlib/3.3.2-intel-compilers-2023.2.1
    ('INTERPOS', '9.2.0', '', ('iimkl', '2023b')),  # INTERPOS/9.2.0-iimkl-2023b
    ('Fundamental-Constants', '0.2.1', '', SYSTEM),  # Fundamental-Constants/0.2.1
]

# Build environment of ci-sdcc/st00-header.sh: no toolchain compiler flags, FC of the toolchain,
# COMBO and IMAS_VERSION of the combination.
local_env = 'unset CC CXX F77 F90 CFLAGS CXXFLAGS FFLAGS FCFLAGS F90FLAGS F77FLAGS CPPFLAGS LDFLAGS LIBS OPTFLAGS PRECFLAGS && export FC=ifort IMAS_VERSION=3.42.2 COMBO=intel-2023b-dd3'
# ACTORS_COPY_DIR=none: ci-sdcc/copy_actors.sh of the build scripts copies no actor into ~/public/PYTHON_ACTORS
local_env += ' && export ACTORS_COPY_DIR=none'

# ci-sdcc/st01-build-code.sh: make -C src/ veryclean info library DEBUG=yes, then make -C src/ m3 (build.sh)
prebuildopts = local_env + ' && make -C src/ veryclean info library DEBUG=yes FC="$FC" &&'
build_cmd = 'make'
build_cmd_targets = '-C src/ m3'
buildopts = 'DEBUG=yes FC="$FC"'
maxparallel = 1

files_to_copy = [
    (['src/hcd2core_sources_m3.exe'], 'bin'),
    (['src/build/lib/debug/libhcd2core_sources.a'], 'lib'),
    (['src/build/obj/debug/*.mod'], 'include/hcd2core_sources'),
]

postinstallcmds = [
    # iWrap actor package %(installdir)s/hcd2core_sources (ci-sdcc/st02-build-actor.sh with
    # ACTOR_FOLDER=%(installdir)s; the Makefile picks the yaml from FC and IMAS_VERSION)
    local_env + ' && cd %(start_dir)s && make -C src/ iwrapactor DEBUG=yes FC="$FC" ACTOR_FOLDER=%(installdir)s',
    # MUSCLE3 executable inside the actor package ($ACTOR_FOLDER/<actor>/ layout of HCD-WF)
    'cp -p %(installdir)s/bin/hcd2core_sources_m3.exe %(installdir)s/hcd2core_sources/hcd2core_sources_m3.exe',
    # run kit: the build tree (tracked files of the pinned commit and the build products at their
    # repository paths, without object files), the build stamp of the combination and the links
    # to the actor package that the run scripts expect (made by hcd2core_sources_run_setup)
    'mkdir -p ' + local_kit + " && cd %(start_dir)s && tar --exclude='*.o' --exclude='__pycache__' --exclude=./ci-deps -cf - . | tar -xf - -C " + local_kit,
    local_env + ' && cd ' + local_kit + ' && bash ci-sdcc/build_stamp.sh write .',
    "printf 'hcd2core_sources hcd2core_sources\\n' > " + local_kit + '/.module_actor_links',
    'install -m 0755 %(builddir)s/hcd2core_sources_run_setup.sh %(installdir)s/bin/hcd2core_sources_run_setup',
    'find %(installdir)s -name __pycache__ -type d -prune -exec rm -rf {} +',
]

modextrapaths = {'PYTHONPATH': ''}
modextravars = {
    'IMAS_VERSION': '3.42.2',
    'COMBO': 'intel-2023b-dd3',
    'HCD2CORE_SOURCES_RUN_KIT': local_kit,
}
# stack limit of the config_sdcc*.sh files
modluafooter = 'execute{cmd="ulimit -Ss unlimited 2>/dev/null || true", modeA={"load"}}'

sanity_check_paths = {
    'files': [
        'bin/hcd2core_sources_m3.exe',
        'bin/hcd2core_sources_run_setup',
        'lib/libhcd2core_sources.a',
        'include/hcd2core_sources/hcd2core_sources_module.mod',
        'hcd2core_sources/actor.py',
        'hcd2core_sources/bin/hcd2core_sources_main.exe',
        'hcd2core_sources/lib/libhcd2core_sources.so',
        'hcd2core_sources/hcd2core_sources_m3.exe',
        'run_kit/.build_combo',
        'run_kit/.module_actor_links',
        'run_kit/src/hcd2core_sources_m3.exe',
        'run_kit/run_muscle',
        'run_kit/coupling.ymmsl',
        'run_kit/deps.yaml',
        'run_kit/ci-sdcc/build_stamp.sh',
        'run_kit/ci-sdcc/st00-header.sh',
        'run_kit/ci-sdcc/resolve_deps.sh',
        'run_kit/src/build/lib/debug/libhcd2core_sources.a',
        'run_kit/run_hcd2core_sources.py',
        'run_kit/input/scenario.yaml',
        'run_kit/input/codeparam_hcd2core_source.xml',
    ],
    'dirs': ['hcd2core_sources/input', 'run_kit/input'],
}

sanity_check_commands = [
    "python -c 'from hcd2core_sources.actor import hcd2core_sources as a; print(a)'",
    "python -c 'import imas, ymmsl, libmuscle'",
    "! ldd %(installdir)s/bin/hcd2core_sources_m3.exe | grep 'not found'",
    "! ldd %(installdir)s/hcd2core_sources/bin/hcd2core_sources_main.exe | grep 'not found'",
    'ldd %(installdir)s/bin/hcd2core_sources_m3.exe | grep -q libmuscle',
    'test "$IMAS_VERSION" = "$(pkg-config --modversion al-fortran | cut -d- -f1)"',
    'bash %(installdir)s/run_kit/ci-sdcc/build_stamp.sh check %(installdir)s/run_kit hcd2core-sources',
    'hcd2core_sources_run_setup --help',
]

moduleclass = 'phys'
